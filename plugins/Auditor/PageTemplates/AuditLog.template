// Auditor :: AuditLog page template.
//
// Mounted as a plugin-owned page_templates row by the host's
// PluginRuntime.SyncPluginPageTemplatesAsync. The {{pluginCode}} placeholder
// is substituted with the plugin's 8-char code at registration time so this
// JSX can address the host's per-plugin data endpoint without knowing its
// own code at build time.
function Page() {
  const PLUGIN_CODE = "{{pluginCode}}";

  const formatTimestamp = (value) => {
    if (!value) return "";
    try {
      return new Date(value).toLocaleString();
    } catch (_) {
      return String(value);
    }
  };

  const loadPage = useCallback(async ({ page, pageSize }) => {
    const res = await api.get(
      "/api/admin/plugins/by-code/" + PLUGIN_CODE + "/data/audit-log",
      { params: { limit: pageSize, offset: page * pageSize } }
    );
    const body = (res && res.data) || {};
    return {
      items: Array.isArray(body.rows) ? body.rows : [],
      totalCount: typeof body.total === "number" ? body.total : 0
    };
  }, []);

  const columns = useMemo(() => [
    {
      id: "occurredAt",
      accessorKey: "occurredAt",
      header: "Time",
      enableSorting: false,
      cell: ({ row }) => (
        <Text size="sm" component="span">{formatTimestamp(row.original.occurredAt)}</Text>
      )
    },
    {
      id: "eventType",
      accessorKey: "eventType",
      header: "Event",
      enableSorting: false,
      cell: ({ row }) => <Code>{row.original.eventType}</Code>
    },
    {
      id: "resourceKind",
      accessorKey: "resourceKind",
      header: "Resource",
      enableSorting: false
    },
    {
      id: "resourceLabel",
      accessorKey: "resourceLabel",
      header: "Name",
      enableSorting: false,
      meta: { wrap: true },
      cell: ({ row }) =>
        row.original.resourceLabel ? (
          <Text fw={600} component="span">{row.original.resourceLabel}</Text>
        ) : (
          <Text c="dimmed" component="span">—</Text>
        )
    },
    {
      id: "actorUserName",
      accessorKey: "actorUserName",
      header: "Actor",
      enableSorting: false,
      cell: ({ row }) =>
        row.original.actorUserName ? (
          <Text component="span">{row.original.actorUserName}</Text>
        ) : (
          <Text c="dimmed" component="span">(system)</Text>
        )
    },
    {
      id: "authOutcome",
      accessorKey: "authOutcome",
      header: "Outcome",
      enableSorting: false,
      cell: ({ row }) => {
        const o = row.original.authOutcome;
        const color = o === "Allowed" ? "green" : o === "Denied" ? "red" : "gray";
        return <Badge color={color} variant="filled">{o}</Badge>;
      }
    },
    {
      id: "routePath",
      accessorKey: "routePath",
      header: "Route",
      enableSorting: false,
      meta: { wrap: true },
      cell: ({ row }) => (
        <Text size="sm" c="dimmed" component="span">
          <span style={{ marginRight: 8 }}>{row.original.httpMethod}</span>
          <Code>{row.original.routePath}</Code>
        </Text>
      )
    }
  ], []);

  return (
    <Stack gap="md">
      <Box>
        <Title order={2} mb={4}>Audit Log</Title>
        <Text c="dimmed">
          Audit-grade events captured by the Auditor plugin. Collection is
          driven by the plugin's settings page; rows older than the retention
          window are pruned opportunistically as new events arrive.
        </Text>
      </Box>

      <DataTable
        mode="server"
        loadPage={loadPage}
        queryKey={["audit-log", PLUGIN_CODE]}
        columns={columns}
        rowKey={(r) => String(r.id)}
        columnWidths={["12rem", "auto", "10%", "auto", "12%", "8%", "auto"]}
        searchEnabled={false}
        emptyMessage="No audit log entries yet. Enable collection on the Auditor Settings page to start recording."
        loadingMessage="Loading audit log…"
      />
    </Stack>
  );
}
