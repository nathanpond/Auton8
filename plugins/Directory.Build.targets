<Project>

    <!-- After each plugin builds, package its bin output into a single .zip
         the admin UI can upload. Excludes *.pdb and the abstractions dll
         (the host owns the canonical copy; shipping it inside the plugin
         would break type identity across ALCs). -->
    <Target Name="ZipPluginPackage" AfterTargets="Build">
        <PropertyGroup>
            <PluginStagingDir>$(IntermediateOutputPath)plugin-staging\</PluginStagingDir>
            <PluginDistDir>$(MSBuildProjectDirectory)\dist\</PluginDistDir>
            <PluginZipPath>$(PluginDistDir)$(MSBuildProjectName).zip</PluginZipPath>
        </PropertyGroup>

        <ItemGroup>
            <!-- Strip assemblies that PluginAssemblyLoadContext.SharedAssemblies
                 redirects to the host's default ALC. Shipping local copies in
                 the plugin zip would be dead weight at best, type-identity
                 hazards at worst if the redirection set ever drifts. -->
            <PluginPayload Include="$(OutputPath)**\*"
                           Exclude="
                               $(OutputPath)**\*.pdb;
                               $(OutputPath)AutoNate.Plugin.Abstractions.dll;
                               $(OutputPath)Microsoft.Extensions.DependencyInjection.Abstractions.dll;
                               $(OutputPath)Microsoft.Extensions.Logging.Abstractions.dll;
                               $(OutputPath)Npgsql.dll;
                               $(OutputPath)Dapper.dll;
                               $(OutputPath)plugin-staging\**" />
        </ItemGroup>

        <RemoveDir Directories="$(PluginStagingDir);$(PluginDistDir)" />
        <MakeDir Directories="$(PluginStagingDir);$(PluginDistDir)" />

        <Copy SourceFiles="@(PluginPayload)"
              DestinationFiles="@(PluginPayload->'$(PluginStagingDir)%(RecursiveDir)%(Filename)%(Extension)')" />

        <ZipDirectory SourceDirectory="$(PluginStagingDir)"
                      DestinationFile="$(PluginZipPath)"
                      Overwrite="true" />

        <Message Importance="high" Text="Plugin packaged: $(PluginZipPath)" />
    </Target>

</Project>
