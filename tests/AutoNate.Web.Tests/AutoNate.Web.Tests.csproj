<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
        <PackageReference Include="xunit" Version="2.9.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AutoNate.Web/AutoNate.Web.csproj" />
        <ProjectReference Include="../AutoNate.Web.Tests.SamplePlugin/AutoNate.Web.Tests.SamplePlugin.csproj">
            <!-- We don't reference any of its types directly; we just want the
                 plugin's output staged under test-plugins/SamplePlugin/ so
                 PluginLoaderTests can load it via PluginAssemblyLoadContext. -->
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../infra/postgres/init/01-create-autonate-db.sql" Link="Sql/01-create-autonate-db.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="../../infra/postgres/init/02-create-autonate-app-schema.sql" Link="Sql/02-create-autonate-app-schema.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <Target Name="StageSamplePluginForTests" AfterTargets="Build">
        <PropertyGroup>
            <SamplePluginSrc>$(MSBuildThisFileDirectory)..\AutoNate.Web.Tests.SamplePlugin\bin\$(Configuration)\$(TargetFramework)\</SamplePluginSrc>
            <SamplePluginDst>$(OutputPath)test-plugins\SamplePlugin\</SamplePluginDst>
        </PropertyGroup>
        <ItemGroup>
            <SamplePluginFiles Include="$(SamplePluginSrc)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(SamplePluginFiles)"
              DestinationFolder="$(SamplePluginDst)%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition="Exists('$(SamplePluginSrc)')" />
    </Target>

</Project>
