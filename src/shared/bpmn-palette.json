    },
    {
      "localName": "dataOutput",
      "eventDefinition": null,
      "reason": "A process-level data declaration, made in the element data editor (#166); it is not a shape."
    },
    {
      "localName": "startEvent",
      "eventDefinition": "error",
      "reason": "Legal only inside an event sub-process; reached through that start event's replace menu, where the palette cannot place it."
    },
    {
      "localName": "startEvent",
      "eventDefinition": "escalation",
      "reason": "Legal only inside an event sub-process; reached through that start event's replace menu, where the palette cannot place it."
    },
    {
      "localName": "*",
      "eventDefinition": "multiInstanceLoopCharacteristics:parallel",
      "reason": "A marker on an existing activity, set in the element data editor. Not a shape."
    },
    {
      "localName": "*",
      "eventDefinition": "multiInstanceLoopCharacteristics:sequential",
      "reason": "A marker on an existing activity, set in the element data editor. Not a shape."
    },
    {
      "localName": "*",
