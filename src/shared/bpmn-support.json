{
  "$comment": "The one source of truth for what the workflow studio offers and what the engine will run (#107). The SPA imports this file for the BPMN types reference panel; AutoNate.Web embeds these same bytes and refuses a deployment containing anything the engine cannot execute. Keyed on (localName, eventDefinition) because a localName-only key cannot tell the eight boundary variants apart, and seven of them execute.",
  "$fields": {
    "studio": {
      "$doc": "What the studio advertises. Drives the BPMN types panel and nothing else.",
      "supported": "Authorable in the studio today. For an executable element that means configurable and running; for an annotation it means drawable, which is all one can be.",
      "coming-soon": "Offered by BPMN and runnable by the engine, but Auton8 has not wired the authoring side yet. An M4/M5 story owns it.",
      "withdrawn": "Will not be built. Not advertised anywhere."
    },
    "engine": {
      "$doc": "What Flowable actually does with it, established by deploying it (#103). Drives publish validation and nothing else.",
      "executes": "Deploys and runs.",
      "annotation": "Deploys and carries no execution semantics BY DESIGN — a BPMN artifact, not a gap. Never refused.",
      "cannot-execute": "Deploys into silence, or is rejected by the engine. Refused at publish, quoting `reason`."
    },
    "$invariant": "studio=supported implies engine is not cannot-execute. The studio may not claim support for something the engine will not run; BpmnSupportManifestTests enforces it."
  },
