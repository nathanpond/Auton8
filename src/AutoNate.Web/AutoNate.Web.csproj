<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DefaultItemExcludes>$(DefaultItemExcludes);ColorAdmin\**</DefaultItemExcludes>

        <SpaRoot>..\AutoNate.Spa\</SpaRoot>
        <SpaDist>$(SpaRoot)dist\</SpaDist>
        <!-- Vite's dist/ is copied to wwwroot/ so the SPA is served at the site root. -->
        <SpaPublishDir>wwwroot\</SpaPublishDir>
        <!-- In Debug we serve the SPA via Vite's dev server (SpaProxy spawns `npm run
             dev` from launchSettings), so `npm run build` would just produce wwwroot
             files nothing reads. Default BuildSpa to true only for Release/publish, where
             the bundled wwwroot is what gets shipped. Override either way with
             /p:BuildSpa=true|false. -->
        <BuildSpa Condition="'$(BuildSpa)' == '' AND '$(Configuration)' == 'Release'">true</BuildSpa>
        <BuildSpa Condition="'$(BuildSpa)' == ''">false</BuildSpa>

        <!-- SpaProxy auto-launches `npm run dev` (Vite) when the .NET app starts in
             Development and redirects the browser from the kestrel URL to the Vite URL.
             Activated by ASPNETCORE_HOSTINGSTARTUPASSEMBLIES in launchSettings.json. -->
        <SpaProxyServerUrl>http://localhost:5173/</SpaProxyServerUrl>
        <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Dapr.AspNetCore" Version="1.17.9" />
      <PackageReference Include="Dapr.Client" Version="1.17.9" />
      <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.7" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql" Version="9.0.3" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <SpaInput Include="$(SpaRoot)src\**\*.*" />
        <SpaInput Include="$(SpaRoot)public\**\*.*" />
        <SpaInput Include="$(SpaRoot)index.html" />
        <SpaInput Include="$(SpaRoot)package.json" />
        <SpaInput Include="$(SpaRoot)package-lock.json" />
        <SpaInput Include="$(SpaRoot)vite.config.ts" />
        <SpaInput Include="$(SpaRoot)tsconfig*.json" />
    </ItemGroup>

    <Target Name="BuildReactSpa"
            BeforeTargets="ResolveStaticWebAssetsInputs;AssignTargetPaths;BeforeBuild"
            Condition="'$(BuildSpa)' == 'true'"
            Inputs="@(SpaInput)"
            Outputs="$(SpaPublishDir)index.html">
        <Message Importance="high" Text="Building React SPA at $(SpaRoot) (Configuration=$(Configuration))" />
        <!-- Vite owns its own static-asset bundle at public/vendor/bpmn-js. If it's missing
             (fresh clone, someone ran git clean, etc.), rebuild it before Vite consumes it. -->
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\"
              Command="npm run vendor:bpmn"
              Condition="!Exists('$(SpaRoot)public\vendor\bpmn-js\bpmn-modeler.development.js')" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="!Exists('$(SpaRoot)node_modules')" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
        <ItemGroup>
            <SpaDistFiles Include="$(SpaDist)**\*" />
            <!-- The SDK caches the static-asset manifest in obj/ across builds. Wiping those
                 caches ensures the next ResolveStaticWebAssetsInputs discovers only the files
                 Vite just produced, not yesterday's hashed filenames. -->
            <SpaStaleCache Include="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\staticwebassets*.*" />
            <SpaStaleCache Include="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\staticwebassets\**\*" />
            <SpaStaleCache Include="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\*.dswa.cache.json" />
            <SpaStaleCache Include="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\swae*.cache" />
            <SpaStaleCache Include="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\scopedcss\**\*" />
            <!-- Also wipe the bin manifests. The .NET incremental build will reuse these
                 when present, even if their referenced hashed asset names no longer exist
                 in wwwroot/spa, producing "No file exists for the asset" errors. -->
            <SpaStaleCache Include="$(OutputPath)$(MSBuildProjectName).staticwebassets.*.json" />
        </ItemGroup>
        <!-- wwwroot/ is 100% Vite output (favicon and other source assets live in
             the SPA's public/ folder), so wipe the whole dir and replace from dist/. -->
        <RemoveDir Directories="$(SpaPublishDir)" Condition="Exists('$(SpaPublishDir)')" />
        <Delete Files="@(SpaStaleCache)" ContinueOnError="true" />
        <Copy SourceFiles="@(SpaDistFiles)" DestinationFolder="$(SpaPublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CleanSpaOutput" BeforeTargets="Clean">
        <RemoveDir Directories="$(SpaDist);$(SpaPublishDir)" />
    </Target>

</Project>
