{
  "ConnectionStrings": {
    // Pool tuning for transient-drop resilience (was producing sporadic
    // EF Core 20004 'connection error' lines under burst SPA load):
    //   - Keepalive=30 / Tcp Keepalive=true: OS-level TCP keepalive every
    //     30s on idle pool connections, so dead sockets are detected before
    //     the next request grabs them.
    //   - Connection Idle Lifetime=60 (default 300): prune connections that
    //     have been idle for >60s, well below the typical Postgres
    //     idle_in_transaction_session_timeout / 5-minute default we trip on.
    //   - Connection Pruning Interval=10 (default 10, explicit for clarity):
    //     how often the pool scans for idle-too-long connections.
    "Default": "Host=localhost;Port=5432;Database=AutoNate;Username=autonate;Password=Your_password123!;Keepalive=30;Tcp Keepalive=true;Connection Idle Lifetime=60;Connection Pruning Interval=10",
    // Second DB on the same cluster used by SqlType DataStores (per-datastore
    // schema + read-only role, materialised dataset caches). DatastoresDatabaseInitializer
    // creates the DB and the shared writer role on first boot. Same pool-tuning
    // params as Default for the same transient-drop resilience reasons.
    "Datastores": "Host=localhost;Port=5432;Database=autonate_datastores;Username=autonate;Password=Your_password123!;Keepalive=30;Tcp Keepalive=true;Connection Idle Lifetime=60;Connection Pruning Interval=10"
  },
  "Flowable": {
    "BaseUrl": "http://localhost:8080/flowable-rest",
    "Username": "rest-admin",
    "Password": "test"
  },
  "Dapr": {
    "AppId": "autonate-web",
    "HttpEndpoint": "http://127.0.0.1:3500",
    "GrpcEndpoint": "http://127.0.0.1:50001",
    "PlacementHostAddress": "127.0.0.1:50006",
    "SchedulerHostAddress": "127.0.0.1:50007",
    "StateStoreName": "statestore",
    "PubSubName": "pubsub"
  },
  "Nats": {
    "Url": "nats://127.0.0.1:4222"
  },
  "WorkflowBehaviors": {
    "CallbackSharedSecret": "dev-only-workflow-behavior-secret-change-me"
  },
  "YjsServer": {
    "InternalSharedSecret": "dev-only-yjs-internal-secret-change-me",
    "HocuspocusWsUrl": "ws://localhost:1234",
    "TicketTtlSeconds": 60
  },
  "DevelopmentAutoLogin": {
    "Enabled": false,
    "Username": "admin"
  },
  // The local Keycloak (#98) is reached by its compose service name, which the
  // shipped allowlist has no reason to know about. Development-only on purpose:
  // an administrator-supplied provider URL is fetched server-side, so this
  // allowlist is the SSRF control, and widening it in appsettings.json would
  // widen it for every install.
  //
  // Note only the pre-flight configuration tester consults this — the sign-in
  // flow does not. That asymmetry is real and is recorded on #98.
  "ExternalConnections": {
    "AllowedProviderHosts": {
      "IdentityProvider:Oidc": [ "keycloak" ],
      "IdentityProvider:Saml": [ "keycloak" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "AutoNate.Web.Services.Events.DaprAuditEventPublisher": "Warning",
      "AutoNate.Web.Services.BusWatcher": "Warning",
      "AutoNate.Web.Services.Signals.DaprStreamingSubscriber": "Warning"
    },
    "Console": {
      // Default simple-console formatter compresses errors to a single line
      // and drops the exception body. Switch to multi-line so when an EF
      // Core 20004 or similar fires we see the actual Npgsql/PostgresException
      // (idle-pool drop, broken pipe, server-side cancellation, etc.) below
      // the lead line.
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "ReloadStaticAssetsAtRuntime": false,
  "Authorization": {
    "Enabled": true,
    "Enforcement": "full",
    // False, matching appsettings.json. The bootstrap administrator grants
    // itself SuperAdmin (see BootstrapAdminOptions), so a fresh dev database
    // no longer needs the backfill to produce a usable account — and a dev who
    // creates deliberately-limited local users should not have them promoted
    // by a restart.
    "AssignSuperAdminToAllExistingUsers": false,
    "DryRun": false
  },
  "AllowedHosts": "*"

}
