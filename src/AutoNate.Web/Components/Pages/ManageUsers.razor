@page "/manage-users"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@inject ILocalUserStore LocalUserStore
@inject IJSRuntime JS

<PageTitle>Manage Users</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-header mb-1">Manage Users</h1>
        <p class="page-head-copy">Manage local users with client-side search, sorting, paging, and quick account actions.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-success" role="status">
        @_statusMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title">Users</h4>
    </div>
    <div class="panel-body">
        <button
            type="button"
            class="btn btn-primary d-none"
            @ref="_addUserButton"
            @onclick="OpenAddUserModal">
            <i class="fa fa-plus me-2"></i>Add User
        </button>

        <div class="table-responsive">
            <table id="manage-users-table" @ref="_tableElement" width="100%" class="table table-striped table-bordered align-middle text-nowrap">
                <thead>
                    <tr>
                        <th class="text-nowrap">Username</th>
                        <th class="text-nowrap">Full Name</th>
                        <th class="text-nowrap">Last Name</th>
                        <th class="text-nowrap">Last Login</th>
                        <th class="text-nowrap" data-orderable="false">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users)
                    {
                        <tr>
                            <td>
                                <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold align-baseline" @onclick="() => OpenEditUserModal(user)">
                                    @user.Username
                                </button>
                            </td>
                            <td>@GetFullName(user)</td>
                            <td>@user.LastName</td>
                            <td data-order="@GetLastLoginSortValue(user)">
                                @FormatLastLogin(user.LastLoginDate)
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <button
                                        type="button"
                                        class="btn btn-outline-warning btn-sm"
                                        title="Reset password"
                                        @onclick="() => OpenResetPasswordModal(user)">
                                        <i class="fa fa-key"></i>
                                    </button>
                                    <button
                                        type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        title="Delete user"
                                        @onclick="() => OpenDeleteUserModal(user)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_showAddUserModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add User</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModals"></button>
                </div>
                <EditForm Model="_addUserModel" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <InputText class="form-control" @bind-Value="_addUserModel.Username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">First Name</label>
                            <InputText class="form-control" @bind-Value="_addUserModel.FirstName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Last Name</label>
                            <InputText class="form-control" @bind-Value="_addUserModel.LastName" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Password</label>
                            <InputText class="form-control" type="password" @bind-Value="_addUserModel.Password" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">Add User</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_showEditUserModal && _selectedUser is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModals"></button>
                </div>
                <EditForm Model="_editUserModel" OnValidSubmit="SaveUserAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <InputText class="form-control" @bind-Value="_editUserModel.Username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">First Name</label>
                            <InputText class="form-control" @bind-Value="_editUserModel.FirstName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Last Name</label>
                            <InputText class="form-control" @bind-Value="_editUserModel.LastName" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="_editUserModel.Email" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">Save Changes</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_showResetPasswordModal && _selectedUser is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModals"></button>
                </div>
                <EditForm Model="_resetPasswordModel" OnValidSubmit="ResetPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary />
                        <p class="text-body text-opacity-50">Set a new password for <strong>@_selectedUser.Username</strong>.</p>
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <InputText class="form-control" type="password" @bind-Value="_resetPasswordModel.Password" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Confirm Password</label>
                            <InputText class="form-control" type="password" @bind-Value="_resetPasswordModel.ConfirmPassword" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">Cancel</button>
                        <button type="submit" class="btn btn-warning" disabled="@_isSaving">Reset Password</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_showDeleteUserModal && _selectedUser is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete User</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete <strong>@_selectedUser.Username</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteUserAsync" disabled="@_isSaving">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private readonly AddUserFormModel _addUserModel = new();
    private readonly EditUserFormModel _editUserModel = new();
    private readonly ResetPasswordFormModel _resetPasswordModel = new();
    private IReadOnlyList<LocalUser> _users = [];
    private LocalUser? _selectedUser;
    private ElementReference _tableElement;
    private ElementReference _addUserButton;
    private IJSObjectReference? _manageUsersModule;
    private bool _tableInitialized;
    private bool _tableNeedsRefresh;
    private bool _isSaving;
    private bool _showAddUserModal;
    private bool _showEditUserModal;
    private bool _showResetPasswordModal;
    private bool _showDeleteUserModal;
    private string? _statusMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_tableNeedsRefresh)
        {
            return;
        }

        _manageUsersModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/manage-users.js");
        await _manageUsersModule.InvokeVoidAsync("initializeManageUsersTable", _tableElement, _addUserButton, _tableInitialized);
        _tableInitialized = true;
        _tableNeedsRefresh = false;
    }

    private async Task LoadUsersAsync()
    {
        _users = await LocalUserStore.ListAsync();
        _tableNeedsRefresh = true;
    }

    private void OpenAddUserModal()
    {
        CloseModals();
        _addUserModel.Username = string.Empty;
        _addUserModel.FirstName = string.Empty;
        _addUserModel.LastName = string.Empty;
        _addUserModel.Password = string.Empty;
        _showAddUserModal = true;
    }

    private void OpenEditUserModal(LocalUser user)
    {
        CloseModals();
        _selectedUser = user;
        _editUserModel.Id = user.Id;
        _editUserModel.Username = user.Username;
        _editUserModel.FirstName = user.FirstName;
        _editUserModel.LastName = user.LastName;
        _editUserModel.Email = user.Email;
        _showEditUserModal = true;
    }

    private void OpenResetPasswordModal(LocalUser user)
    {
        CloseModals();
        _selectedUser = user;
        _resetPasswordModel.Id = user.Id;
        _resetPasswordModel.Password = string.Empty;
        _resetPasswordModel.ConfirmPassword = string.Empty;
        _showResetPasswordModal = true;
    }

    private void OpenDeleteUserModal(LocalUser user)
    {
        CloseModals();
        _selectedUser = user;
        _showDeleteUserModal = true;
    }

    private void CloseModals()
    {
        _showAddUserModal = false;
        _showEditUserModal = false;
        _showResetPasswordModal = false;
        _showDeleteUserModal = false;
        _selectedUser = null;
        _errorMessage = null;
    }

    private async Task CreateUserAsync()
    {
        await RunSaveAsync(
            async () =>
            {
                await LocalUserStore.CreateAsync(
                    _addUserModel.Username,
                    _addUserModel.FirstName,
                    _addUserModel.LastName,
                    _addUserModel.Password);
                _statusMessage = $"User '{_addUserModel.Username}' was created.";
                await LoadUsersAsync();
                CloseModals();
            });
    }

    private async Task SaveUserAsync()
    {
        await RunSaveAsync(
            async () =>
            {
                var updated = await LocalUserStore.UpdateAsync(
                    _editUserModel.Id,
                    _editUserModel.Username,
                    _editUserModel.FirstName,
                    _editUserModel.LastName,
                    _editUserModel.Email);

                if (updated is null)
                {
                    throw new InvalidOperationException("The user could not be found.");
                }

                _statusMessage = $"User '{updated.Username}' was updated.";
                await LoadUsersAsync();
                CloseModals();
            });
    }

    private async Task ResetPasswordAsync()
    {
        await RunSaveAsync(
            async () =>
            {
                var reset = await LocalUserStore.ResetPasswordAsync(_resetPasswordModel.Id, _resetPasswordModel.Password);
                if (!reset)
                {
                    throw new InvalidOperationException("The user could not be found.");
                }

                _statusMessage = $"Password reset for '{_selectedUser?.Username}'.";
                CloseModals();
            });
    }

    private async Task DeleteUserAsync()
    {
        if (_selectedUser is null)
        {
            return;
        }

        await RunSaveAsync(
            async () =>
            {
                var deleted = await LocalUserStore.DeleteAsync(_selectedUser.Id);
                if (!deleted)
                {
                    throw new InvalidOperationException("The user could not be found.");
                }

                _statusMessage = $"User '{_selectedUser.Username}' was deleted.";
                await LoadUsersAsync();
                CloseModals();
            });
    }

    private async Task RunSaveAsync(Func<Task> action)
    {
        _isSaving = true;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            await action();
        }
        catch (InvalidOperationException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetFullName(LocalUser user)
    {
        return $"{user.FirstName} {user.LastName}".Trim();
    }

    private static string FormatLastLogin(DateTimeOffset? lastLogin)
    {
        return lastLogin?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never";
    }

    private static long GetLastLoginSortValue(LocalUser user)
    {
        return user.LastLoginDate?.UtcTicks ?? long.MinValue;
    }

    public async ValueTask DisposeAsync()
    {
        if (_manageUsersModule is not null)
        {
            try
            {
                await _manageUsersModule.InvokeVoidAsync("disposeManageUsersTable", _tableElement);
                await _manageUsersModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed class AddUserFormModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string FirstName { get; set; } = string.Empty;

        [Required]
        public string LastName { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }

    private sealed class EditUserFormModel
    {
        public long Id { get; set; }

        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string FirstName { get; set; } = string.Empty;

        [Required]
        public string LastName { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }

    private sealed class ResetPasswordFormModel
    {
        public long Id { get; set; }

        [Required]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
