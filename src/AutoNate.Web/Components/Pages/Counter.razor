@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-header mb-1">Counter</h1>
        <p class="page-head-copy">A simple interactive sample inside the ColorAdmin shell.</p>
    </div>
</div>

<div class="panel panel-inverse">
    <div class="panel-heading">
        <h4 class="panel-title">Interactive Counter</h4>
    </div>
    <div class="panel-body">
        <p role="status" class="fs-4 mb-3">Current count: <strong>@currentCount</strong></p>
        <button class="btn btn-primary" @onclick="IncrementCount">Increment</button>
    </div>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

}
