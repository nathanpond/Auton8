@page "/bus-watcher"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using AutoNate.Web.Services.Dapr
@inject IJSRuntime JS
@inject DaprSidecarProbe DaprSidecarProbe

<PageTitle>Bus Watcher</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-header mb-1">Bus Watcher</h1>
        <p class="page-head-copy bus-watcher-copy">Watch every workflow bus event the app consumes and stream it into a live log window.</p>
    </div>
</div>

<div class="bus-watcher-toolbar">
    <span class="bus-watcher-status @GetStatusClass()">@_connectionStatus</span>
    <button class="btn btn-outline-secondary" @onclick="ClearLog">Clear Log</button>
</div>

@if (!string.IsNullOrWhiteSpace(_startupWarning))
{
    <div class="bus-watcher-warning" role="alert">
        @_startupWarning
    </div>
}

<div class="bus-watcher-shell">
    @if (_entries.Count == 0)
    {
        <p class="bus-watcher-empty">Waiting for bus traffic...</p>
    }
    else
    {
        <div class="bus-watcher-log" role="log" aria-live="polite" aria-label="Bus event log">
            @foreach (var entry in _entries)
            {
                <article class="bus-watcher-entry">
                    <div class="bus-watcher-entry-meta">
                        <span class="bus-watcher-entry-time">@entry.ReceivedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</span>
                        <span class="bus-watcher-entry-topic">@entry.Topic</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(entry.ContentType) || entry.Headers.Count > 0)
                    {
                        <pre class="bus-watcher-entry-headers">@FormatHeaders(entry)</pre>
                    }

                    <pre class="bus-watcher-entry-payload">@entry.Payload</pre>
                </article>
            }
        </div>
    }
</div>

@code {
    private const int MaxEntries = 250;

    private readonly JsonSerializerOptions _serializerOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    private readonly List<BusWatcherLogEntry> _entries = [];

    private DotNetObjectReference<BusWatcher>? _selfReference;
    private IJSObjectReference? _module;
    private IJSObjectReference? _connectionHandle;
    private string _connectionStatus = "Connecting...";
    private string? _startupWarning;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfReference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bus-watcher.js");
        _connectionHandle = await _module.InvokeAsync<IJSObjectReference>("createBusWatcherConnection", _selfReference);

        if (!await DaprSidecarProbe.IsAvailableAsync())
        {
            _startupWarning =
                "The web app is running without a reachable Dapr sidecar, so workflow pub/sub events will not arrive here. Start AutoNate with `make app-dapr` or a Rider run configuration that launches the app through Dapr.";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnBusMessage(string messageJson)
    {
        var entry = JsonSerializer.Deserialize<BusWatcherLogEntry>(messageJson, _serializerOptions);
        if (entry is null)
        {
            return;
        }

        _entries.Add(entry);
        if (_entries.Count > MaxEntries)
        {
            _entries.RemoveAt(0);
        }

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnConnectionStatusChanged(string status)
    {
        _connectionStatus = status;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearLog()
    {
        _entries.Clear();
    }

    private string GetStatusClass()
    {
        return _connectionStatus.StartsWith("Connected", StringComparison.OrdinalIgnoreCase)
            ? "bus-watcher-status-connected"
            : "bus-watcher-status-connecting";
    }

    private static string FormatHeaders(BusWatcherLogEntry entry)
    {
        var headerLines = new List<string>();

        if (!string.IsNullOrWhiteSpace(entry.ContentType))
        {
            headerLines.Add($"content-type: {entry.ContentType}");
        }

        foreach (var header in entry.Headers)
        {
            if (header.Key.Equals("content-type", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            headerLines.Add($"{header.Key}: {header.Value}");
        }

        return string.Join(Environment.NewLine, headerLines);
    }

    public async ValueTask DisposeAsync()
    {
        if (_connectionHandle is not null)
        {
            try
            {
                await _connectionHandle.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_connectionHandle is not null)
        {
            await _connectionHandle.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _selfReference?.Dispose();
    }

    private sealed record BusWatcherLogEntry(
        DateTimeOffset ReceivedAtUtc,
        string Topic,
        string? ContentType,
        Dictionary<string, string> Headers,
        string Payload);
}
