@page "/home"

<PageTitle>Home</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-header mb-1">Automation Dashboard</h1>
        <p class="page-head-copy">ColorAdmin now drives the application shell, navigation, and dashboard styling. Use the workflow tools below to model, inspect, and monitor automations.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="widget widget-stats bg-gradient-blue">
            <div class="stats-icon stats-icon-lg"><i class="fa fa-diagram-project fa-fw"></i></div>
            <div class="stats-content">
                <div class="stats-title">WORKFLOW DESIGN</div>
                <div class="dashboard-stat-number">Studio Ready</div>
                <div class="dashboard-stat-label">Build, save, deploy, and launch BPMN flows</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="widget widget-stats bg-gradient-green">
            <div class="stats-icon stats-icon-lg"><i class="fa fa-list-check fa-fw"></i></div>
            <div class="stats-content">
                <div class="stats-title">EXECUTION TRACE</div>
                <div class="dashboard-stat-number">Live History</div>
                <div class="dashboard-stat-label">Inspect active and completed workflow runs</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="widget widget-stats bg-gradient-orange-red">
            <div class="stats-icon stats-icon-lg"><i class="fa fa-tower-broadcast fa-fw"></i></div>
            <div class="stats-content">
                <div class="stats-title">EVENT STREAM</div>
                <div class="dashboard-stat-number">Bus Watcher</div>
                <div class="dashboard-stat-label">Observe integration traffic in real time</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="widget widget-stats bg-gradient-gray-dark">
            <div class="stats-icon stats-icon-lg"><i class="fa fa-layer-group fa-fw"></i></div>
            <div class="stats-content">
                <div class="stats-title">THEME STATUS</div>
                <div class="dashboard-stat-number">ColorAdmin</div>
                <div class="dashboard-stat-label">All runtime assets are served from the main app</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-4">
        <a class="quick-link-card" href="workflow">
            <div class="quick-link-card-title">
                <i class="fa fa-diagram-project text-primary"></i>
                <span>Open Workflow Studio</span>
            </div>
            <p class="quick-link-card-copy">Create new process drafts, iterate on BPMN diagrams, and deploy directly to Flowable.</p>
        </a>
    </div>
    <div class="col-xl-4">
        <a class="quick-link-card" href="workflow-executions">
            <div class="quick-link-card-title">
                <i class="fa fa-list-check text-success"></i>
                <span>Review Executions</span>
            </div>
            <p class="quick-link-card-copy">Track the newest runs, inspect their current step, and drill into full diagram state.</p>
        </a>
    </div>
    <div class="col-xl-4">
        <a class="quick-link-card" href="bus-watcher">
            <div class="quick-link-card-title">
                <i class="fa fa-tower-broadcast text-warning"></i>
                <span>Monitor Bus Traffic</span>
            </div>
            <p class="quick-link-card-copy">Watch the app’s workflow event stream and validate published payloads as they arrive.</p>
        </a>
    </div>
</div>
