@page "/workflow-executions"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@using AutoNate.Web.Services.BusWatcher
@inject IJSRuntime JS
@inject IFlowableClient FlowableClient
@inject BusWatcherStreamService BusWatcherStreamService
@inject ILogger<WorkflowExecutions> Logger

<PageTitle>Workflow Executions</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-header mb-1">Workflow Executions</h1>
        <p class="page-head-copy workflow-executions-copy">View every execution in the system, with the newest runs first and live step details for anything still in progress.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success" role="status">
        @_successMessage
    </div>
}

<div class="workflow-executions-toolbar">
    <span class="badge text-bg-light">@_workflowEventConnectionStatus</span>
    <button class="btn btn-outline-primary" @onclick="LoadExecutionsAsync" disabled="@_isLoading">Refresh</button>

    @if (_isLoading)
    {
        <span class="workflow-executions-loading">Loading executions...</span>
    }
</div>

<div class="workflow-executions-card">
    @if (_executions.Count == 0 && !_isLoading && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <p class="workflow-executions-empty">No workflow executions have been recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle workflow-executions-table">
                <thead>
                <tr>
                    <th scope="col">Execution ID</th>
                    <th scope="col">Started</th>
                    <th scope="col">Status</th>
                    <th scope="col">Current Step</th>
                    <th scope="col" class="workflow-executions-actions-header">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var execution in _executions)
                {
                    <tr class="workflow-execution-row" @onclick="() => OpenExecutionAsync(execution.Id)">
                        <td class="workflow-execution-id">@execution.Id</td>
                        <td>@FormatTimestamp(execution.StartedAtUtc)</td>
                        <td>
                            <span class="@GetStatusBadgeClass(execution.Status)">@execution.Status</span>
                        </td>
                        <td>@(execution.CurrentStep ?? "Not running")</td>
                        <td class="workflow-executions-actions-cell">
                            <button
                                type="button"
                                class="btn btn-outline-danger btn-sm workflow-execution-delete-button"
                                title="Delete execution"
                                aria-label="Delete execution @execution.Id"
                                disabled="@IsDeletingExecution(execution.Id)"
                                @onclick="() => DeleteExecutionAsync(execution)"
                                @onclick:stopPropagation="true">
                                @if (IsDeletingExecution(execution.Id))
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span>Deleting...</span>
                                }
                                else
                                {
                                    <svg class="workflow-execution-delete-icon" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5.5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Zm2 .5a.5.5 0 0 1 1 0v6a.5.5 0 0 1-1 0V6Z"></path>
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9.5A1.5 1.5 0 0 1 11.5 15h-7A1.5 1.5 0 0 1 3 13.5V4h-.5a1 1 0 1 1 0-2H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1ZM4 4v9.5a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V4H4Zm3-2v1h2V2H7Z"></path>
                                    </svg>
                                    <span>Delete</span>
                                }
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_isExecutionModalOpen)
{
    <div class="workflow-execution-modal-backdrop" @onclick="CloseExecutionModalAsync">
        <div class="workflow-execution-modal" @onclick:stopPropagation="true">
            <div class="workflow-execution-modal-header">
                <div>
                    <h2>Execution @_selectedExecutionId</h2>
                    <p class="workflow-execution-modal-copy">Read-only execution view with completed, current, and future steps highlighted.</p>
                </div>

                <button class="btn btn-outline-secondary" @onclick="CloseExecutionModalAsync">Close</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @_modalErrorMessage
                </div>
            }

            @if (_isExecutionDetailLoading)
            {
                <p class="workflow-executions-loading">Loading execution diagram...</p>
            }
            else if (_selectedExecutionDetail is not null)
            {
                <div class="workflow-execution-legend">
                    <span><span class="workflow-execution-swatch workflow-execution-swatch-completed"></span> Completed</span>
                    <span><span class="workflow-execution-swatch workflow-execution-swatch-current"></span> Current</span>
                    <span><span class="workflow-execution-swatch workflow-execution-swatch-future"></span> Future</span>
                </div>

                <div class="workflow-execution-viewer-shell">
                    <div @ref="_viewerCanvas" class="workflow-execution-viewer-canvas" aria-label="Read-only BPMN execution diagram"></div>
                </div>
            }
        </div>
    </div>
}

@code {
    private ElementReference _viewerCanvas;
    private readonly JsonSerializerOptions _serializerOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };
    private List<WorkflowExecutionSummary> _executions = [];
    private IDisposable? _busSubscription;
    private IJSObjectReference? _viewerModule;
    private IJSObjectReference? _viewerHandle;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _modalErrorMessage;
    private string? _selectedExecutionId;
    private WorkflowExecutionDiagramDetail? _selectedExecutionDetail;
    private HashSet<string> _deletingExecutionIds = [];
    private bool _isLoading;
    private bool _isExecutionDetailLoading;
    private bool _isExecutionModalOpen;
    private bool _viewerRefreshPending;
    private string _workflowEventConnectionStatus = "Watching bus";

    protected override async Task OnInitializedAsync()
    {
        await LoadExecutionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _busSubscription = BusWatcherStreamService.Subscribe(message => InvokeAsync(() => ProcessBusMessageAsync(message)));
            Logger.LogInformation("WorkflowExecutions subscribed to in-process bus messages.");
        }

        if (!_isExecutionModalOpen || !_viewerRefreshPending || _selectedExecutionDetail is null)
        {
            return;
        }

        try
        {
            _viewerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/workflow.js");

            if (_viewerHandle is null)
            {
                _viewerHandle = await _viewerModule.InvokeAsync<IJSObjectReference>(
                    "createReadonlyViewer",
                    _viewerCanvas,
                    _selectedExecutionDetail.BpmnXml);
            }
            else
            {
                await _viewerModule.InvokeVoidAsync("loadReadonlyDiagram", _viewerHandle, _selectedExecutionDetail.BpmnXml);
            }

            await _viewerModule.InvokeVoidAsync(
                "highlightExecutionState",
                _viewerHandle,
                _selectedExecutionDetail.CompletedActivityIds,
                _selectedExecutionDetail.CurrentActivityIds);

            _viewerRefreshPending = false;
        }
        catch (JSException exception)
        {
            _modalErrorMessage = $"The execution diagram could not be rendered. {exception.Message}";
            _viewerRefreshPending = false;
            await DisposeViewerAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ProcessBusMessageAsync(BusWatcherStreamService.BusWatcherMessage message)
    {
        if (!message.Topic.StartsWith(BusWatcherStreamService.TopicName, StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(message.Payload))
        {
            return;
        }

        Logger.LogInformation("WorkflowExecutions received bus message for topic {Topic}.", message.Topic);

        var payload = TryDeserializeWorkflowExecutionPayload(message.Payload);
        if (payload is null || string.IsNullOrWhiteSpace(payload.ProcessInstanceId))
        {
            Logger.LogWarning(
                "WorkflowExecutions ignored bus message for topic {Topic} because payload could not be parsed. Payload: {Payload}",
                message.Topic,
                message.Payload);
            return;
        }

        Logger.LogInformation(
            "WorkflowExecutions processing event {EventType} for process {ProcessInstanceId}.",
            payload.EventType,
            payload.ProcessInstanceId);

        var isNewExecution = !_executions.Any(item => string.Equals(item.Id, payload.ProcessInstanceId, StringComparison.Ordinal));
        if (isNewExecution)
        {
            Logger.LogInformation("WorkflowExecutions detected new process {ProcessInstanceId}; reloading executions.", payload.ProcessInstanceId);
            await LoadExecutionsAsync();
        }

        var shouldRefreshViewer = ApplyWorkflowExecutionEvent(payload);
        if (shouldRefreshViewer && _viewerHandle is not null && _viewerModule is not null && _selectedExecutionDetail is not null)
        {
            await _viewerModule.InvokeVoidAsync(
                "highlightExecutionState",
                _viewerHandle,
                _selectedExecutionDetail.CompletedActivityIds,
                _selectedExecutionDetail.CurrentActivityIds);
        }

        await InvokeAsync(StateHasChanged);
        Logger.LogInformation(
            "WorkflowExecutions applied event {EventType} for process {ProcessInstanceId}. Execution count: {ExecutionCount}.",
            payload.EventType,
            payload.ProcessInstanceId,
            _executions.Count);
    }

    private async Task LoadExecutionsAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            _executions = (await FlowableClient.GetWorkflowExecutionsAsync()).ToList();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool ApplyWorkflowExecutionEvent(WorkflowExecutionEventPayload payload)
    {
        UpsertExecutionSummary(payload);
        return UpdateSelectedExecutionDetail(payload);
    }

    private WorkflowExecutionEventPayload? TryDeserializeWorkflowExecutionPayload(string payloadJson)
    {
        var decodedCloudEventPayload = TryDecodeCloudEventPayload(payloadJson);
        if (!string.IsNullOrWhiteSpace(decodedCloudEventPayload))
        {
            var decodedPayload = TryDeserializeWorkflowExecutionPayloadFromJson(decodedCloudEventPayload);
            if (decodedPayload is not null)
            {
                return decodedPayload;
            }

            Logger.LogWarning("WorkflowExecutions could not parse decoded CloudEvent payload: {DecodedPayload}", decodedCloudEventPayload);
        }

        try
        {
            return JsonSerializer.Deserialize<WorkflowExecutionEventPayload>(payloadJson, _serializerOptions);
        }
        catch (JsonException)
        {
        }

        try
        {
            var envelope = JsonSerializer.Deserialize<WorkflowExecutionEventEnvelope>(payloadJson, _serializerOptions);
            return envelope?.Payload ?? TryDeserializeWorkflowExecutionPayloadFromJson(payloadJson);
        }
        catch (JsonException)
        {
            return TryDeserializeWorkflowExecutionPayloadFromJson(payloadJson);
        }
    }

    private static string? TryDecodeCloudEventPayload(string payloadJson)
    {
        try
        {
            var cloudEvent = JsonSerializer.Deserialize<WorkflowExecutionCloudEvent>(payloadJson, new JsonSerializerOptions(JsonSerializerDefaults.Web)
            {
                PropertyNameCaseInsensitive = true
            });

            if (string.IsNullOrWhiteSpace(cloudEvent?.DataBase64))
            {
                return null;
            }

            var decodedPayloadBytes = Convert.FromBase64String(cloudEvent.DataBase64);
            return System.Text.Encoding.UTF8.GetString(decodedPayloadBytes);
        }
        catch (JsonException)
        {
            return null;
        }
        catch (FormatException)
        {
            return null;
        }
    }

    private WorkflowExecutionEventPayload? TryDeserializeWorkflowExecutionPayloadFromJson(string payloadJson)
    {
        try
        {
            using var document = JsonDocument.Parse(payloadJson);
            var root = document.RootElement;

            if (root.ValueKind == JsonValueKind.Object
                && TryGetProperty(root, "payload", out var nestedPayload)
                && nestedPayload.ValueKind == JsonValueKind.Object)
            {
                root = nestedPayload;
            }

            if (root.ValueKind == JsonValueKind.Object
                && TryGetProperty(root, "data", out var nestedData)
                && nestedData.ValueKind == JsonValueKind.Object)
            {
                root = nestedData;
            }

            if (root.ValueKind == JsonValueKind.String)
            {
                var nestedJson = root.GetString();
                if (!string.IsNullOrWhiteSpace(nestedJson))
                {
                    return TryDeserializeWorkflowExecutionPayloadFromJson(nestedJson);
                }
            }

            var processInstanceId = GetString(root, "processInstanceId");
            var eventType = GetString(root, "eventType");
            if (string.IsNullOrWhiteSpace(processInstanceId) || string.IsNullOrWhiteSpace(eventType))
            {
                return null;
            }

            return new WorkflowExecutionEventPayload(
                GetString(root, "eventId") ?? string.Empty,
                eventType,
                GetDateTimeOffset(root, "occurredAtUtc"),
                processInstanceId,
                GetString(root, "processDefinitionId"),
                GetString(root, "processDefinitionKey"),
                GetString(root, "processDefinitionName"),
                GetString(root, "activityId"),
                GetString(root, "activityName"),
                GetString(root, "taskId"),
                GetString(root, "taskName"),
                GetString(root, "assignee"),
                GetString(root, "tenantId"),
                GetString(root, "rawFlowableEventType"),
                GetString(root, "sourceAppId"));
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private void UpsertExecutionSummary(WorkflowExecutionEventPayload payload)
    {
        var execution = _executions.FirstOrDefault(item => string.Equals(item.Id, payload.ProcessInstanceId, StringComparison.Ordinal));
        var currentStep = ResolveCurrentStep(payload);
        var status = ResolveStatus(payload.EventType);

        if (execution is null)
        {
            _executions.Add(new WorkflowExecutionSummary
            {
                Id = payload.ProcessInstanceId,
                StartedAtUtc = payload.OccurredAtUtc,
                Status = status,
                CurrentStep = currentStep
            });
        }
        else
        {
            execution.StartedAtUtc ??= payload.OccurredAtUtc;
            execution.Status = status;

            if (IsTerminalEvent(payload.EventType))
            {
                execution.CurrentStep = null;
            }
            else if (!string.IsNullOrWhiteSpace(currentStep))
            {
                execution.CurrentStep = currentStep;
            }
        }

        SortExecutions();
    }

    private bool UpdateSelectedExecutionDetail(WorkflowExecutionEventPayload payload)
    {
        if (_selectedExecutionDetail is null
            || !string.Equals(_selectedExecutionDetail.ExecutionId, payload.ProcessInstanceId, StringComparison.Ordinal))
        {
            return false;
        }

        var completed = new HashSet<string>(_selectedExecutionDetail.CompletedActivityIds, StringComparer.Ordinal);
        var current = new HashSet<string>(_selectedExecutionDetail.CurrentActivityIds, StringComparer.Ordinal);
        var activityId = payload.ActivityId;

        if (!string.IsNullOrWhiteSpace(activityId))
        {
            if (IsActivityCompletedEvent(payload.EventType))
            {
                current.Remove(activityId);
                completed.Add(activityId);
            }
            else if (IsCurrentActivityEvent(payload.EventType))
            {
                if (!completed.Contains(activityId))
                {
                    current.Add(activityId);
                }
            }
        }

        if (IsTerminalEvent(payload.EventType))
        {
            current.Clear();
        }

        var completedList = completed.ToArray();
        var currentList = current.ToArray();

        if (_selectedExecutionDetail.CompletedActivityIds.SequenceEqual(completedList, StringComparer.Ordinal)
            && _selectedExecutionDetail.CurrentActivityIds.SequenceEqual(currentList, StringComparer.Ordinal))
        {
            return false;
        }

        _selectedExecutionDetail = _selectedExecutionDetail with
        {
            CompletedActivityIds = completedList,
            CurrentActivityIds = currentList
        };

        return true;
    }

    private void SortExecutions()
    {
        _executions = _executions
            .OrderByDescending(execution => execution.StartedAtUtc ?? DateTimeOffset.MinValue)
            .ThenByDescending(execution => execution.Id, StringComparer.Ordinal)
            .ToList();
    }

    private bool IsDeletingExecution(string executionId)
    {
        return _deletingExecutionIds.Contains(executionId);
    }

    private static string GetStatusBadgeClass(string status)
    {
        if (string.Equals(status, "Running", StringComparison.OrdinalIgnoreCase))
        {
            return "badge text-bg-primary";
        }

        if (string.Equals(status, "Failed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return "badge text-bg-danger";
        }

        return "badge text-bg-success";
    }

    private async Task OpenExecutionAsync(string executionId)
    {
        if (IsDeletingExecution(executionId))
        {
            return;
        }

        _selectedExecutionId = executionId;
        _selectedExecutionDetail = null;
        _modalErrorMessage = null;
        _isExecutionModalOpen = true;
        _isExecutionDetailLoading = true;
        _viewerRefreshPending = false;

        try
        {
            _selectedExecutionDetail = await FlowableClient.GetWorkflowExecutionDiagramDetailAsync(executionId);
            _viewerRefreshPending = true;
        }
        catch (Exception exception)
        {
            _modalErrorMessage = exception.Message;
        }
        finally
        {
            _isExecutionDetailLoading = false;
        }
    }

    private async Task DeleteExecutionAsync(WorkflowExecutionSummary execution)
    {
        if (IsDeletingExecution(execution.Id))
        {
            return;
        }

        _errorMessage = null;
        _successMessage = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete workflow execution '{execution.Id}'? This will permanently remove it from AutoNate and Flowable.");

        if (!confirmed)
        {
            return;
        }

        _deletingExecutionIds.Add(execution.Id);

        try
        {
            await FlowableClient.DeleteWorkflowExecutionAsync(execution.Id);

            if (string.Equals(_selectedExecutionId, execution.Id, StringComparison.Ordinal))
            {
                await CloseExecutionModalAsync();
            }

            _executions.RemoveAll(item => string.Equals(item.Id, execution.Id, StringComparison.Ordinal));
            _successMessage = $"Execution '{execution.Id}' was deleted.";
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _deletingExecutionIds.Remove(execution.Id);
        }
    }

    private async Task CloseExecutionModalAsync()
    {
        _isExecutionModalOpen = false;
        _isExecutionDetailLoading = false;
        _viewerRefreshPending = false;
        _modalErrorMessage = null;
        _selectedExecutionId = null;
        _selectedExecutionDetail = null;

        await DisposeViewerAsync();
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp)
    {
        return timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "Not available";
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeViewerAsync();

        _busSubscription?.Dispose();

        if (_viewerModule is not null)
        {
            try
            {
                await _viewerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static string ResolveCurrentStep(WorkflowExecutionEventPayload payload)
    {
        return FirstNonEmpty(payload.TaskName, payload.ActivityName, payload.ActivityId) ?? "Running";
    }

    private static string ResolveStatus(string eventType)
    {
        return eventType switch
        {
            "process.completed" => "Complete",
            "process.cancelled" => "Cancelled",
            "process.completed.error" or "job.execution.failed" => "Failed",
            _ => "Running"
        };
    }

    private static bool IsCurrentActivityEvent(string eventType)
    {
        return eventType is "process.started" or "activity.started" or "task.created" or "task.assigned";
    }

    private static bool IsActivityCompletedEvent(string eventType)
    {
        return eventType is "activity.completed" or "task.completed";
    }

    private static bool IsTerminalEvent(string eventType)
    {
        return eventType is "process.completed" or "process.cancelled" or "process.completed.error" or "job.execution.failed";
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        return values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
    }

    private static bool TryGetProperty(JsonElement element, string propertyName, out JsonElement propertyValue)
    {
        foreach (var property in element.EnumerateObject())
        {
            if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                propertyValue = property.Value;
                return true;
            }
        }

        propertyValue = default;
        return false;
    }

    private static string? GetString(JsonElement element, string propertyName)
    {
        if (!TryGetProperty(element, propertyName, out var propertyValue))
        {
            return null;
        }

        return propertyValue.ValueKind switch
        {
            JsonValueKind.Null => null,
            JsonValueKind.String => propertyValue.GetString(),
            JsonValueKind.Number => propertyValue.GetRawText(),
            JsonValueKind.True => bool.TrueString,
            JsonValueKind.False => bool.FalseString,
            _ => propertyValue.GetRawText()
        };
    }

    private static DateTimeOffset GetDateTimeOffset(JsonElement element, string propertyName)
    {
        if (!TryGetProperty(element, propertyName, out var propertyValue))
        {
            return DateTimeOffset.UtcNow;
        }

        if (propertyValue.ValueKind == JsonValueKind.String
            && DateTimeOffset.TryParse(propertyValue.GetString(), out var parsedDateTimeOffset))
        {
            return parsedDateTimeOffset;
        }

        if (propertyValue.ValueKind == JsonValueKind.Number)
        {
            if (propertyValue.TryGetInt64(out var integerTimestamp))
            {
                return integerTimestamp >= 1_000_000_000_000
                    ? DateTimeOffset.FromUnixTimeMilliseconds(integerTimestamp)
                    : DateTimeOffset.FromUnixTimeSeconds(integerTimestamp);
            }

            if (propertyValue.TryGetDouble(out var decimalTimestamp))
            {
                var seconds = (long)Math.Truncate(decimalTimestamp);
                var fractionalSeconds = decimalTimestamp - seconds;
                return DateTimeOffset.FromUnixTimeSeconds(seconds).AddSeconds(fractionalSeconds);
            }
        }

        return DateTimeOffset.UtcNow;
    }

    private async Task DisposeViewerAsync()
    {
        if (_viewerModule is not null && _viewerHandle is not null)
        {
            try
            {
                await _viewerModule.InvokeVoidAsync("disposeModeler", _viewerHandle);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        if (_viewerHandle is not null)
        {
            try
            {
                await _viewerHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
            finally
            {
                _viewerHandle = null;
            }
        }
    }
    private sealed record WorkflowExecutionEventEnvelope(
        string? Topic,
        WorkflowExecutionEventPayload Payload);

    private sealed record WorkflowExecutionCloudEvent(
        [property: JsonPropertyName("data_base64")] string? DataBase64);

    private sealed record WorkflowExecutionEventPayload(
        string EventId,
        string EventType,
        DateTimeOffset OccurredAtUtc,
        string ProcessInstanceId,
        string? ProcessDefinitionId,
        string? ProcessDefinitionKey,
        string? ProcessDefinitionName,
        string? ActivityId,
        string? ActivityName,
        string? TaskId,
        string? TaskName,
        string? Assignee,
        string? TenantId,
        string? RawFlowableEventType,
        string? SourceAppId);
}
