@page "/workflow-executions"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IFlowableClient FlowableClient

<PageTitle>Workflow Executions</PageTitle>

<h1>Workflow Executions</h1>

<p class="workflow-executions-copy">View every execution in the system, with the newest runs first and live step details for anything still in progress.</p>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

<div class="workflow-executions-toolbar">
    <button class="btn btn-outline-primary" @onclick="LoadExecutionsAsync" disabled="@_isLoading">Refresh</button>

    @if (_isLoading)
    {
        <span class="workflow-executions-loading">Loading executions...</span>
    }
</div>

<div class="workflow-executions-card">
    @if (_executions.Count == 0 && !_isLoading && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <p class="workflow-executions-empty">No workflow executions have been recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle workflow-executions-table">
                <thead>
                <tr>
                    <th scope="col">Execution ID</th>
                    <th scope="col">Started</th>
                    <th scope="col">Status</th>
                    <th scope="col">Current Step</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var execution in _executions)
                {
                    <tr class="workflow-execution-row" @onclick="() => OpenExecutionAsync(execution.Id)">
                        <td class="workflow-execution-id">@execution.Id</td>
                        <td>@FormatTimestamp(execution.StartedAtUtc)</td>
                        <td>
                            <span class="@GetStatusBadgeClass(execution.Status)">@execution.Status</span>
                        </td>
                        <td>@(execution.CurrentStep ?? "Not running")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_isExecutionModalOpen)
{
    <div class="workflow-execution-modal-backdrop" @onclick="CloseExecutionModalAsync">
        <div class="workflow-execution-modal" @onclick:stopPropagation="true">
            <div class="workflow-execution-modal-header">
                <div>
                    <h2>Execution @_selectedExecutionId</h2>
                    <p class="workflow-execution-modal-copy">Read-only execution view with completed, current, and future steps highlighted.</p>
                </div>

                <button class="btn btn-outline-secondary" @onclick="CloseExecutionModalAsync">Close</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @_modalErrorMessage
                </div>
            }

            @if (_isExecutionDetailLoading)
            {
                <p class="workflow-executions-loading">Loading execution diagram...</p>
            }
            else if (_selectedExecutionDetail is not null)
            {
                <div class="workflow-execution-legend">
                    <span><span class="workflow-execution-swatch workflow-execution-swatch-completed"></span> Completed</span>
                    <span><span class="workflow-execution-swatch workflow-execution-swatch-current"></span> Current</span>
                    <span><span class="workflow-execution-swatch workflow-execution-swatch-future"></span> Future</span>
                </div>

                <div class="workflow-execution-viewer-shell">
                    <div @ref="_viewerCanvas" class="workflow-execution-viewer-canvas" aria-label="Read-only BPMN execution diagram"></div>
                </div>
            }
        </div>
    </div>
}

@code {
    private ElementReference _viewerCanvas;
    private List<WorkflowExecutionSummary> _executions = [];
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewerHandle;
    private string? _errorMessage;
    private string? _modalErrorMessage;
    private string? _selectedExecutionId;
    private WorkflowExecutionDiagramDetail? _selectedExecutionDetail;
    private bool _isLoading;
    private bool _isExecutionDetailLoading;
    private bool _isExecutionModalOpen;
    private bool _viewerRefreshPending;

    protected override async Task OnInitializedAsync()
    {
        await LoadExecutionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isExecutionModalOpen || !_viewerRefreshPending || _selectedExecutionDetail is null)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/workflow.js");

        if (_viewerHandle is null)
        {
            _viewerHandle = await _module.InvokeAsync<IJSObjectReference>(
                "createReadonlyViewer",
                _viewerCanvas,
                _selectedExecutionDetail.BpmnXml);
        }
        else
        {
            await _module.InvokeVoidAsync("loadReadonlyDiagram", _viewerHandle, _selectedExecutionDetail.BpmnXml);
        }

        await _module.InvokeVoidAsync(
            "highlightExecutionState",
            _viewerHandle,
            _selectedExecutionDetail.CompletedActivityIds,
            _selectedExecutionDetail.CurrentActivityIds);

        _viewerRefreshPending = false;
    }

    private async Task LoadExecutionsAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            _executions = (await FlowableClient.GetWorkflowExecutionsAsync()).ToList();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetStatusBadgeClass(string status)
    {
        return string.Equals(status, "Running", StringComparison.OrdinalIgnoreCase)
            ? "badge text-bg-primary"
            : "badge text-bg-success";
    }

    private async Task OpenExecutionAsync(string executionId)
    {
        _selectedExecutionId = executionId;
        _selectedExecutionDetail = null;
        _modalErrorMessage = null;
        _isExecutionModalOpen = true;
        _isExecutionDetailLoading = true;
        _viewerRefreshPending = false;

        try
        {
            _selectedExecutionDetail = await FlowableClient.GetWorkflowExecutionDiagramDetailAsync(executionId);
            _viewerRefreshPending = true;
        }
        catch (Exception exception)
        {
            _modalErrorMessage = exception.Message;
        }
        finally
        {
            _isExecutionDetailLoading = false;
        }
    }

    private async Task CloseExecutionModalAsync()
    {
        _isExecutionModalOpen = false;
        _isExecutionDetailLoading = false;
        _viewerRefreshPending = false;
        _modalErrorMessage = null;
        _selectedExecutionId = null;
        _selectedExecutionDetail = null;

        if (_module is not null && _viewerHandle is not null)
        {
            await _module.InvokeVoidAsync("disposeModeler", _viewerHandle);
            await _viewerHandle.DisposeAsync();
            _viewerHandle = null;
        }
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp)
    {
        return timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "Not available";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null && _viewerHandle is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeModeler", _viewerHandle);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_viewerHandle is not null)
        {
            try
            {
                await _viewerHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
