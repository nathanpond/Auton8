    }

    private async Task DisposeModelerHandleAsync()
    {
        if (_module is not null && _modelerHandle is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeModeler", _modelerHandle);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_modelerHandle is not null)
        {
            try
            {
                await _modelerHandle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _modelerHandle = null;
        _modelerReady = false;
        _loadedEditorWorkflowId = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeModelerHandleAsync();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }
}
