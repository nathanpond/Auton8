@page "/workflow"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IWorkflowModelStore WorkflowModelStore
@inject IFlowableClient FlowableClient

<PageTitle>Workflow</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-header mb-1">Workflow Studio</h1>
        <p class="page-head-copy workflow-copy">Select a saved workflow model, edit it in the browser, save drafts to AutoNate, publish to Flowable, and start new executions from the current model.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert alert-success" role="alert">
        @_statusMessage
    </div>
}

@if (_warningMessages.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <strong>Compatibility warnings</strong>
        <ul class="workflow-warning-list">
            @foreach (var warning in _warningMessages)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

<div class="workflow-toolbar">
    <div class="workflow-selector-panel">
        <label class="workflow-field">
            <span>Workflow Model</span>
            <div class="workflow-selector-inputs">
                <select class="form-select" value="@SelectedWorkflowId" @onchange="OnWorkflowSelectionChangedAsync" disabled="@(_isBusy || _isCreatingWorkflow)">
                    <option value="">@(_workflowModels.Count == 0 ? "No workflow models yet" : "Select a workflow model")</option>
                    @foreach (var model in _workflowModels)
                    {
                        <option value="@model.Id">@model.Name</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-secondary workflow-add-button" @onclick="OpenCreateWorkflowModalAsync" disabled="@_isBusy" aria-label="Create workflow model" title="Create workflow model">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                </button>
            </div>
        </label>
    </div>

    <div class="workflow-actions">
        <button class="btn btn-primary" @onclick="SaveWorkflowAsync" disabled="@(!_modelerReady || _isBusy || _currentModel is null)" title="Save">Save</button>
        <button class="btn btn-outline-primary" @onclick="PublishAsync" disabled="@(!CanPublish)" title="Publish">Publish</button>
        <button class="btn btn-outline-success" @onclick="StartInstanceAsync" disabled="@(!CanStartInstance)" title="Start instance">Start Instance</button>
    </div>
</div>

@if (_isBusy)
{
    <p class="workflow-busy">Working on @_busyOperation...</p>
}

<div class="workflow-layout">
    <section class="workflow-main">
        @if (_currentModel is null)
        {
            <div class="workflow-empty-state">
                <div class="workflow-empty-icon">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                </div>
                <h2>Create Your First Workflow</h2>
                <p>Workflow models live in the application database and are loaded into the modeler from there. Create one to start modeling.</p>
                <button type="button" class="btn btn-primary" @onclick="OpenCreateWorkflowModalAsync" title="Create workflow model">Create Workflow Model</button>
            </div>
        }
        else
        {
            <div class="workflow-shell">
                <div @key="_editorCanvasKey" @ref="_canvas" class="workflow-canvas" aria-label="BPMN modeler"></div>
            </div>
        }
    </section>

    <aside class="workflow-sidebar">
        <section class="workflow-card">
            <h2>Model</h2>

            @if (_currentModel is null)
            {
                <p class="workflow-muted">No workflow model is selected.</p>
            }
            else
            {
                <dl class="workflow-meta">
                    <div>
                        <dt>Model ID</dt>
                        <dd>@_currentModel.Id</dd>
                    </div>
                    <div>
                        <dt>Name</dt>
                        <dd>@_currentModel.Name</dd>
                    </div>
                    <div>
                        <dt>Draft Status</dt>
                        <dd>@DraftStatusLabel</dd>
                    </div>
                    <div>
                        <dt>Draft Version</dt>
                        <dd>v@(_currentModel.DraftVersionNumber)</dd>
                    </div>
                    <div>
                        <dt>Published Version</dt>
                        <dd>@(_currentModel.PublishedVersionNumber is null ? "Not published" : $"v{_currentModel.PublishedVersionNumber}")</dd>
                    </div>
                    <div>
                        <dt>Updated</dt>
                        <dd>@FormatTimestamp(_currentModel.UpdatedAtUtc)</dd>
                    </div>
                </dl>
            }
        </section>

        <section class="workflow-card">
            <h2>Deployment</h2>

            @if (_currentModel?.LastDeployment is null)
            {
                <p class="workflow-muted">This workflow model has not been published to Flowable yet.</p>
            }
            else
            {
                @if (HasPersistedDraft || _isDirty)
                {
                    <p class="workflow-muted">The current workflow is in draft state. Publish it to deploy this version to Flowable.</p>
                }

                <dl class="workflow-meta">
                    <div>
                        <dt>Definition ID</dt>
                        <dd>@_currentModel.LastDeployment.ProcessDefinitionId</dd>
                    </div>
                    <div>
                        <dt>Version</dt>
                        <dd>@_currentModel.LastDeployment.ProcessDefinitionVersion</dd>
                    </div>
                    <div>
                        <dt>Deployment ID</dt>
                        <dd>@_currentModel.LastDeployment.DeploymentId</dd>
                    </div>
                    <div>
                        <dt>Published</dt>
                        <dd>@FormatTimestamp(_currentModel.LastDeployment.DeployedAtUtc)</dd>
                    </div>
                </dl>
            }
        </section>

        <section class="workflow-card">
            <h2>Runtime</h2>

            <dl class="workflow-meta">
                <div>
                    <dt>Instance</dt>
                    <dd>@(_activeProcessInstanceId ?? "Not started")</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>@_runtimeStatus</dd>
                </div>
                <div>
                    <dt>Active Tasks</dt>
                    <dd>@_runtimeTasks.Count</dd>
                </div>
            </dl>

            @if (_runtimeTasks.Count > 0)
            {
                <div class="workflow-task-list">
                    @foreach (var task in _runtimeTasks)
                    {
                        <div class="workflow-task">
                            <div>
                                <strong>@task.Name</strong>
                                <div class="workflow-task-meta">Task ID: @task.Id</div>
                            </div>
                            <button class="btn btn-sm btn-success" @onclick="() => CompleteTaskAsync(task.Id)" title="Complete @task.Name">Complete @task.Name</button>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_activeProcessInstanceId))
            {
                <p class="workflow-muted">No active tasks are currently available for the selected workflow instance.</p>
            }
        </section>
    </aside>
</div>

@if (_showCreateWorkflowModal)
{
    <div class="workflow-modal-backdrop" @onclick="CloseCreateWorkflowModal">
        <div class="workflow-modal" role="dialog" aria-modal="true" aria-labelledby="create-workflow-title" @onclick:stopPropagation="true">
            <div class="workflow-modal-header">
                <div>
                    <h2 id="create-workflow-title">Create Workflow Model</h2>
                    <p class="workflow-modal-copy">Name the new workflow model. AutoNate will create a blank draft in the database and load it into the modeler.</p>
                </div>
                <button type="button" class="btn-close" aria-label="Close" title="Close" @onclick="CloseCreateWorkflowModal"></button>
            </div>

            <label class="workflow-field">
                <span>Workflow Name</span>
                <input class="form-control" @bind="_newWorkflowName" @bind:event="oninput" @onkeydown="HandleCreateModalKeydownAsync" />
            </label>

            <div class="workflow-modal-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateWorkflowModal" disabled="@_isBusy" title="Cancel">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="CreateWorkflowAsync" disabled="@(_isBusy || string.IsNullOrWhiteSpace(_newWorkflowName))" title="Create">Create</button>
            </div>
        </div>
    </div>
}

@if (_showScriptTaskModal && _scriptTaskEditor is not null)
{
    <div class="workflow-modal-backdrop" @onclick="CloseScriptTaskModal">
        <div class="workflow-modal workflow-script-task-modal" role="dialog" aria-modal="true" aria-labelledby="script-task-title" @onclick:stopPropagation="true">
            <div class="workflow-modal-header">
                <div>
                    <h2 id="script-task-title">Script Task</h2>
                    <p class="workflow-modal-copy">Edit the selected BPMN script task. AutoNate saves the JavaScript body inline in the BPMN XML and validates it before save or publish.</p>
                </div>
                <button type="button" class="btn-close" aria-label="Close" title="Close" @onclick="CloseScriptTaskModal"></button>
            </div>

            <div class="workflow-script-task-meta">
                <span class="workflow-script-task-pill">@_scriptTaskEditor.Id</span>
                <span class="workflow-script-task-pill">@_scriptTaskEditor.Type</span>
            </div>

            <label class="workflow-field">
                <span>Task Name</span>
                <input class="form-control" @bind="_scriptTaskEditor.Name" @bind:event="oninput" />
            </label>

            <label class="workflow-field">
                <span>Script Format</span>
                <input class="form-control" value="javascript" readonly />
            </label>

            <label class="workflow-field">
                <span>Result Variable</span>
                <input class="form-control" @bind="_scriptTaskEditor.ResultVariable" @bind:event="oninput" />
            </label>

            <label class="workflow-field">
                <span>Script Body</span>
                <textarea class="form-control workflow-script-task-editor" rows="12" spellcheck="false" @bind="_scriptTaskEditor.Script" @bind:event="oninput"></textarea>
            </label>

            <div class="workflow-modal-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseScriptTaskModal" disabled="@_isBusy" title="Close">Close</button>
                <button type="button" class="btn btn-primary" @onclick="ApplyScriptTaskChangesAsync" disabled="@(_isBusy || !_modelerReady || _modelerHandle is null)" title="Apply">Apply</button>
            </div>
        </div>
    </div>
}

@if (_showSequenceFlowModal && _sequenceFlowEditor is not null)
{
    <div class="workflow-modal-backdrop" @onclick="CloseSequenceFlowModal">
        <div class="workflow-modal workflow-sequence-flow-modal" role="dialog" aria-modal="true" aria-labelledby="sequence-flow-title" @onclick:stopPropagation="true">
            <div class="workflow-modal-header">
                <div>
                    <h2 id="sequence-flow-title">Sequence Flow</h2>
                    <p class="workflow-modal-copy">Edit the selected path leaving a task or gateway. Use a Flowable expression like <code>${needsApproval}</code> or <code>${riskLevel == 'high'}</code> to route decisions based on process variables.</p>
                </div>
                <button type="button" class="btn-close" aria-label="Close" title="Close" @onclick="CloseSequenceFlowModal"></button>
            </div>

            <div class="workflow-script-task-meta">
                <span class="workflow-script-task-pill">@_sequenceFlowEditor.Id</span>
                <span class="workflow-script-task-pill">@_sequenceFlowEditor.Type</span>
            </div>

            <label class="workflow-field">
                <span>Flow Name</span>
                <input class="form-control" @bind="_sequenceFlowEditor.Name" @bind:event="oninput" />
            </label>

            <label class="workflow-field">
                <span>Condition Expression</span>
                <textarea class="form-control workflow-expression-editor" rows="6" spellcheck="false" @bind="_sequenceFlowEditor.ConditionExpression" @bind:event="oninput"></textarea>
            </label>

            <p class="workflow-modal-note">Leave the condition blank for an unconditional path. For exclusive gateways, put the condition on the outgoing branch itself, not on the gateway node.</p>

            <div class="workflow-modal-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseSequenceFlowModal" disabled="@_isBusy" title="Close">Close</button>
                <button type="button" class="btn btn-primary" @onclick="ApplySequenceFlowChangesAsync" disabled="@(_isBusy || !_modelerReady || _modelerHandle is null)" title="Apply">Apply</button>
            </div>
        </div>
    </div>
}

@code {
    private const string WorkflowModulePath = "./js/workflow.js?v=20260421_02";
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _modelerHandle;
    private DotNetObjectReference<Workflow>? _dotNetReference;
    private readonly List<FlowableTaskSummary> _runtimeTasks = [];
    private IReadOnlyList<WorkflowModel> _workflowModels = [];
    private WorkflowModel? _currentModel;
    private string _currentXml = string.Empty;
    private string? _activeProcessInstanceId;
    private string _runtimeStatus = "Not started";
    private string? _errorMessage;
    private string? _statusMessage;
    private IReadOnlyList<string> _warningMessages = [];
    private string _busyOperation = "workflow";
    private string _newWorkflowName = string.Empty;
    private bool _isBusy;
    private bool _modelerReady;
    private bool _isDirty;
    private bool _isCreatingWorkflow;
    private bool _showCreateWorkflowModal;
    private bool _showScriptTaskModal;
    private bool _showSequenceFlowModal;
    private bool _suppressDirtyNotifications;
    private bool _pendingEditorReload;
    private int _editorCanvasKey;
    private Guid? _loadedEditorWorkflowId;
    private WorkflowElementSnapshot? _selectedElement;
    private ScriptTaskEditorState? _scriptTaskEditor;
    private SequenceFlowEditorState? _sequenceFlowEditor;

    private string SelectedWorkflowId => _currentModel?.Id.ToString() ?? string.Empty;
    private bool HasPersistedDraft => _currentModel?.IsDraft == true;
    private bool HasPublishedDeployment => _currentModel?.LastDeployment is not null && _currentModel.PublishedVersionNumber is not null;
    private bool IsPublishedCurrentVersion => HasPublishedDeployment && !HasPersistedDraft && !_isDirty;
    private bool CanPublish => _modelerReady && !_isBusy && _currentModel is not null && (_isDirty || HasPersistedDraft || _currentModel.LastDeployment is null);
    private bool CanStartInstance => !_isBusy && _currentModel is not null && HasPublishedDeployment;
    private string DraftStatusLabel => _currentModel is null
        ? "No model"
        : _isDirty
            ? $"Unsaved changes for v{_currentModel.DraftVersionNumber}"
            : HasPersistedDraft
                ? $"Draft v{_currentModel.DraftVersionNumber}"
                : $"Published v{_currentModel.DraftVersionNumber}";

    protected override async Task OnInitializedAsync()
    {
        _workflowModels = await WorkflowModelStore.ListAsync();
        _currentModel = _workflowModels.FirstOrDefault();

        if (_currentModel is not null)
        {
            ResetEditorState(_currentModel);
            _isDirty = false;
            await RestoreRuntimeStateAsync();
        }
        else
        {
            _runtimeStatus = "No workflow model selected";
            _showCreateWorkflowModal = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentModel is null)
        {
            return;
        }

        try
        {
            _dotNetReference ??= DotNetObjectReference.Create(this);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", WorkflowModulePath);

            if (_modelerHandle is null)
            {
                _modelerHandle = await _module.InvokeAsync<IJSObjectReference>("createModeler", _canvas, _currentXml, _dotNetReference);
                _modelerReady = true;
                _loadedEditorWorkflowId = _currentModel.Id;
                _pendingEditorReload = false;
                _errorMessage = null;
                _isDirty = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (!_pendingEditorReload && _modelerReady && _loadedEditorWorkflowId == _currentModel.Id)
            {
                return;
            }

            _modelerHandle = await _module.InvokeAsync<IJSObjectReference>("createModeler", _canvas, _currentXml, _dotNetReference);
            _modelerReady = true;
            _loadedEditorWorkflowId = _currentModel.Id;
            _pendingEditorReload = false;
            _errorMessage = null;
            _isDirty = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException exception)
        {
            _errorMessage = $"The BPMN modeler could not load the selected XML. {exception.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task NotifyDiagramChanged()
    {
        if (_suppressDirtyNotifications)
        {
            return Task.CompletedTask;
        }

        _isDirty = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task NotifySelectionChanged(WorkflowElementSnapshot? selectedElement)
    {
        _selectedElement = selectedElement;

        if (selectedElement is not null &&
            string.Equals(selectedElement.Type, "bpmn:ScriptTask", StringComparison.Ordinal))
        {
            _scriptTaskEditor = new ScriptTaskEditorState
            {
                Id = selectedElement.Id,
                Type = selectedElement.Type,
                Name = selectedElement.Name ?? string.Empty,
                ScriptFormat = "javascript",
                Script = selectedElement.Script ?? string.Empty,
                ResultVariable = selectedElement.ResultVariable ?? string.Empty
            };
            _showScriptTaskModal = true;
            _showSequenceFlowModal = false;
            _sequenceFlowEditor = null;
        }
        else if (selectedElement is not null &&
                 string.Equals(selectedElement.Type, "bpmn:SequenceFlow", StringComparison.Ordinal))
        {
            _sequenceFlowEditor = new SequenceFlowEditorState
            {
                Id = selectedElement.Id,
                Type = selectedElement.Type,
                Name = selectedElement.Name ?? string.Empty,
                ConditionExpression = selectedElement.ConditionExpression ?? string.Empty
            };
            _showSequenceFlowModal = true;
            _showScriptTaskModal = false;
            _scriptTaskEditor = null;
        }
        else
        {
            _showScriptTaskModal = false;
            _scriptTaskEditor = null;
            _showSequenceFlowModal = false;
            _sequenceFlowEditor = null;
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task OnWorkflowSelectionChangedAsync(ChangeEventArgs args)
    {
        var selectedValue = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(selectedValue) || !Guid.TryParse(selectedValue, out var workflowId))
        {
            return;
        }

        if (_currentModel?.Id == workflowId)
        {
            return;
        }

        if (!await ConfirmDiscardChangesAsync())
        {
            return;
        }

        await RunBusyAsync("loading the workflow model", async () =>
        {
            var model = await WorkflowModelStore.GetAsync(workflowId)
                ?? throw new InvalidOperationException("The selected workflow model could not be loaded.");

            await DisposeModelerHandleAsync();
            ResetEditorState(model);
            await RestoreRuntimeStateAsync();
            await InvokeAsync(StateHasChanged);
            _statusMessage = await BuildLoadDebugMessageAsync(model);
        });
    }

    private async Task OpenCreateWorkflowModalAsync()
    {
        if (!await ConfirmDiscardChangesAsync())
        {
            return;
        }

        _newWorkflowName = string.Empty;
        _showCreateWorkflowModal = true;
    }

    private void CloseCreateWorkflowModal()
    {
        if (_isBusy)
        {
            return;
        }

        _showCreateWorkflowModal = false;
    }

    private async Task HandleCreateModalKeydownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(_newWorkflowName))
        {
            await CreateWorkflowAsync();
        }
    }

    private async Task CreateWorkflowAsync()
    {
        await RunBusyAsync("creating the workflow model", async () =>
        {
            _isCreatingWorkflow = true;

            var workflowName = WorkflowBpmnXml.NormalizeWorkflowName(_newWorkflowName);
            var processKey = WorkflowBpmnXml.BuildProcessKeyForModel(workflowName);

            var model = await WorkflowModelStore.SaveAsync(new WorkflowModel
            {
                Id = Guid.NewGuid(),
                Name = workflowName,
                ProcessKey = processKey,
                BpmnXml = WorkflowBpmnXml.CreateStarterDiagram(processKey, workflowName)
            });

            await RefreshWorkflowListAsync(model.Id);
            ResetEditorState(model);
            _showCreateWorkflowModal = false;
            _newWorkflowName = string.Empty;
            _statusMessage = $"Created workflow model '{model.Name}'.";
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task SaveWorkflowAsync()
    {
        await RunBusyAsync("saving the workflow draft", async () =>
        {
            var preparedResult = await PrepareModelAsync();
            _currentModel = await WorkflowModelStore.SaveAsync(preparedResult.Model);
            await RefreshWorkflowListAsync(_currentModel.Id);
            _warningMessages = preparedResult.Validation.Warnings;
            _statusMessage = $"Saved workflow model '{_currentModel.Name}'. {preparedResult.DebugSummary}";
            _isDirty = false;
        });
    }

    private void CloseScriptTaskModal()
    {
        if (_isBusy)
        {
            return;
        }

        _showScriptTaskModal = false;
    }

    private void CloseSequenceFlowModal()
    {
        if (_isBusy)
        {
            return;
        }

        _showSequenceFlowModal = false;
    }

    private async Task ApplyScriptTaskChangesAsync()
    {
        await RunBusyAsync("applying script task changes", async () =>
        {
            if (_module is null || _modelerHandle is null || _scriptTaskEditor is null)
            {
                throw new InvalidOperationException("Select a script task before applying script changes.");
            }

            await _module.InvokeVoidAsync("updateScriptTaskProperties", _modelerHandle, _scriptTaskEditor);
            _showScriptTaskModal = false;
        });
    }

    private async Task ApplySequenceFlowChangesAsync()
    {
        await RunBusyAsync("applying sequence flow changes", async () =>
        {
            if (_module is null || _modelerHandle is null || _sequenceFlowEditor is null)
            {
                throw new InvalidOperationException("Select a sequence flow before applying condition changes.");
            }

            await _module.InvokeVoidAsync("updateSequenceFlowProperties", _modelerHandle, _sequenceFlowEditor);
            _showSequenceFlowModal = false;
        });
    }

    private async Task PublishAsync()
    {
        await RunBusyAsync("publishing the workflow model", async () =>
        {
            var preparedResult = await PrepareModelAsync();
            var savedModel = await WorkflowModelStore.SaveAsync(preparedResult.Model);
            var deployment = await FlowableClient.DeployProcessAsync(savedModel);
            _currentModel = await WorkflowModelStore.PublishAsync(savedModel, deployment);
            await RefreshWorkflowListAsync(_currentModel.Id);
            _warningMessages = preparedResult.Validation.Warnings;
            _statusMessage = $"Published '{_currentModel.Name}' draft v{_currentModel.DraftVersionNumber} to Flowable as definition version {deployment.ProcessDefinitionVersion}. {preparedResult.DebugSummary}";
            _isDirty = false;
        });
    }

    private async Task StartInstanceAsync()
    {
        await RunBusyAsync("starting the workflow instance", async () =>
        {
            if (_currentModel is null)
            {
                throw new InvalidOperationException("Select a workflow model before starting an instance.");
            }

            if (_currentModel.LastDeployment is null || _currentModel.PublishedVersionNumber is null)
            {
                throw new InvalidOperationException("Publish the workflow model to Flowable before starting an instance.");
            }

            _warningMessages = WorkflowBpmnXml.ValidateProcess(_currentModel.BpmnXml).Warnings;
            var instance = await FlowableClient.StartProcessInstanceAsync(_currentModel.ProcessKey);
            _activeProcessInstanceId = instance.Id;
            _runtimeStatus = "Running";
            _currentModel = await WorkflowModelStore.SaveAsync(_currentModel with { ActiveProcessInstanceId = instance.Id });
            await RefreshWorkflowListAsync(_currentModel.Id);

            var startedFromPublished = _currentModel.PublishedVersionNumber;
            var hasUnpublishedChanges = _isDirty || _currentModel.IsDraft;
            _statusMessage = hasUnpublishedChanges
                ? $"Started process instance {_activeProcessInstanceId} from published v{startedFromPublished}. Local draft v{_currentModel.DraftVersionNumber} has unpublished changes; publish to run them."
                : $"Started process instance {_activeProcessInstanceId}.";
            await RefreshRuntimeStateCoreAsync();
        });
    }

    private async Task CompleteTaskAsync(string taskId)
    {
        await RunBusyAsync("completing the user task", async () =>
        {
            await FlowableClient.CompleteTaskAsync(taskId);
            _statusMessage = $"Completed task {taskId}.";
            await RefreshRuntimeStateCoreAsync();
        });
    }

    private async Task RefreshRuntimeStateCoreAsync()
    {
        if (string.IsNullOrWhiteSpace(_activeProcessInstanceId))
        {
            _runtimeTasks.Clear();
            _runtimeStatus = _currentModel is null ? "No workflow model selected" : "Not started";
            return;
        }

        var processInstance = await FlowableClient.GetProcessInstanceAsync(_activeProcessInstanceId);
        _runtimeTasks.Clear();
        _runtimeTasks.AddRange(await FlowableClient.GetTasksByProcessInstanceAsync(_activeProcessInstanceId));

        if (processInstance is null && _runtimeTasks.Count == 0)
        {
            _runtimeStatus = "Completed";
            return;
        }

        _runtimeStatus = _runtimeTasks.Count > 0 ? "Waiting on user task" : "Running";
    }

    private async Task<PreparedWorkflowResult> PrepareModelAsync()
    {
        if (_currentModel is null)
        {
            throw new InvalidOperationException("Select or create a workflow model before saving.");
        }

        if (!_modelerReady || _module is null || _modelerHandle is null)
        {
            throw new InvalidOperationException("The BPMN modeler is not ready yet.");
        }

        var exportedXml = await _module.InvokeAsync<string>("saveXml", _modelerHandle);
        var debugInfo = await _module.InvokeAsync<WorkflowSaveDebugInfo>("getSaveDebugInfo", _modelerHandle);
        if (!LooksLikeBpmnXml(exportedXml))
        {
            var preview = exportedXml.Length > 200 ? exportedXml[..200] : exportedXml;
            throw new InvalidOperationException($"Workflow Studio did not receive BPMN XML from the browser save path. Payload preview: {preview}");
        }

        var elementSnapshots = await _module.InvokeAsync<WorkflowElementSnapshot[]>("getElementSnapshots", _modelerHandle);
        var normalizedName = WorkflowBpmnXml.NormalizeWorkflowName(_currentModel.Name);
        var updatedXml = WorkflowBpmnXml.ApplyProcessMetadata(
            exportedXml,
            _currentModel.ProcessKey,
            normalizedName,
            elementSnapshots);
        var validation = WorkflowBpmnXml.ValidateProcess(updatedXml);

        if (validation.Errors.Count > 0)
        {
            throw new InvalidOperationException(string.Join(" ", validation.Errors));
        }

        var definitionChanged = !string.Equals(_currentModel.BpmnXml, updatedXml, StringComparison.Ordinal);
        var activeProcessInstanceId = definitionChanged
            ? null
            : _currentModel.ActiveProcessInstanceId;

        var preparedModel = _currentModel with
        {
            Name = normalizedName,
            BpmnXml = updatedXml,
            ActiveProcessInstanceId = activeProcessInstanceId
        };

        _currentXml = updatedXml;

        if (definitionChanged)
        {
            _activeProcessInstanceId = null;
            _runtimeStatus = "Not started";
            _runtimeTasks.Clear();
        }

        return new PreparedWorkflowResult(preparedModel, validation, BuildDebugSummary(debugInfo));
    }

    private async Task RestoreRuntimeStateAsync()
    {
        _activeProcessInstanceId = _currentModel?.ActiveProcessInstanceId;
        _runtimeTasks.Clear();
        _runtimeStatus = _currentModel is null ? "No workflow model selected" : "Not started";

        if (!string.IsNullOrWhiteSpace(_activeProcessInstanceId))
        {
            await RefreshRuntimeStateCoreAsync();
        }
    }

    private async Task RefreshWorkflowListAsync(Guid selectedWorkflowId)
    {
        _workflowModels = await WorkflowModelStore.ListAsync();
        _currentModel = _workflowModels.FirstOrDefault(model => model.Id == selectedWorkflowId)
            ?? _currentModel;
    }

    private async Task<bool> ConfirmDiscardChangesAsync()
    {
        if (!_isDirty)
        {
            return true;
        }

        return await JS.InvokeAsync<bool>("confirm", "You have unsaved workflow changes. Discard them and continue?");
    }

    private async Task LoadXmlIntoModelerAsync(string xml)
    {
        var normalizedXml = NormalizeEditorXml(xml);

        if (_module is null || _modelerHandle is null)
        {
            _currentXml = normalizedXml;
            return;
        }

        _suppressDirtyNotifications = true;
        try
        {
            await _module.InvokeVoidAsync("loadXml", _modelerHandle, normalizedXml);
            _currentXml = normalizedXml;
            _isDirty = false;
        }
        catch (JSException exception)
        {
            var preview = normalizedXml.Length > 220 ? normalizedXml[..220] : normalizedXml;
            throw new InvalidOperationException(
                $"bpmn.io failed to import the workflow XML. {exception.Message} XML preview: {preview}",
                exception);
        }
        finally
        {
            _suppressDirtyNotifications = false;
        }
    }

    private void ResetEditorState(WorkflowModel model)
    {
        _currentModel = model;
        _currentXml = NormalizeEditorXml(model.BpmnXml);
        _activeProcessInstanceId = model.ActiveProcessInstanceId;
        _isDirty = false;
        _pendingEditorReload = true;
        _editorCanvasKey++;
        _errorMessage = null;
        _warningMessages = WorkflowBpmnXml.ValidateProcess(_currentXml).Warnings;
    }

    private static string FormatTimestamp(DateTimeOffset? timestamp)
    {
        return timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "Not available";
    }

    private static bool LooksLikeBpmnXml(string? xml)
    {
        if (string.IsNullOrWhiteSpace(xml))
        {
            return false;
        }

        return xml.Contains("<bpmn:process", StringComparison.Ordinal) ||
               xml.Contains("<process", StringComparison.Ordinal) ||
               xml.Contains("<bpmn:definitions", StringComparison.Ordinal);
    }

    private static string NormalizeEditorXml(string? xml)
    {
        if (string.IsNullOrWhiteSpace(xml))
        {
            return string.Empty;
        }

        var trimmed = xml.Trim();
        var declarationIndex = trimmed.IndexOf("<?xml", StringComparison.Ordinal);
        return declarationIndex > 0
            ? trimmed[declarationIndex..]
            : trimmed;
    }

    private static string BuildDebugSummary(WorkflowSaveDebugInfo debugInfo)
    {
        return $"Debug: js={debugInfo.Version}, elements={debugInfo.ElementCount}, domElements={debugInfo.DomElementCount}, domShapes={debugInfo.DomShapeCount}, domContainers={debugInfo.DomContainerCount}, save={debugInfo.SaveXmlScore}, defs={debugInfo.DefinitionsScore}, registry={debugInfo.RegistryScore}, manual={debugInfo.ManualRegistryScore}.";
    }

    private async Task<string?> BuildLoadDebugMessageAsync(WorkflowModel model)
    {
        if (_module is null || _modelerHandle is null)
        {
            return null;
        }

        try
        {
            var debugInfo = await _module.InvokeAsync<WorkflowLoadDebugInfo>("getLoadDebugInfo", _modelerHandle);
            if (debugInfo is null)
            {
                return null;
            }

            return $"Loaded '{model.Name}'. Debug: js={debugInfo.Version}, warnings={debugInfo.WarningCount}, elements={debugInfo.ElementCount}, domElements={debugInfo.DomElementCount}, domShapes={debugInfo.DomShapeCount}.";
        }
        catch
        {
            return null;
        }
    }

    private async Task RunBusyAsync(string operation, Func<Task> action)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _busyOperation = operation;
        _errorMessage = null;
        _statusMessage = null;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isBusy = false;
            _isCreatingWorkflow = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed record class PreparedWorkflowResult(
        WorkflowModel Model,
        WorkflowBpmnValidationResult Validation,
        string DebugSummary);

    private sealed record class WorkflowSaveDebugInfo(
        string Version,
        int ElementCount,
        string[] DistinctTypes,
        int DomElementCount,
        int DomShapeCount,
        int DomContainerCount,
        int SaveXmlScore,
        int DefinitionsScore,
        int RegistryScore,
        int ManualRegistryScore);

    private sealed record class WorkflowLoadDebugInfo(
        string Version,
        int WarningCount,
        int ElementCount,
        string[] DistinctTypes,
        int DomElementCount,
        int DomShapeCount);

