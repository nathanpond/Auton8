@inject NavigationManager NavigationManager

<div id="top-menu" class="app-top-menu" data-bs-theme="dark">
    <div class="menu">
        <div class="menu-item menu-brand-item">
            <NavLink class="menu-link menu-brand-link" href="" Match="NavLinkMatch.All" data-enhance-nav="false">
                <div class="menu-icon"><i class="fa fa-robot"></i></div>
                <div class="menu-text"><b>Auto</b> Nate</div>
            </NavLink>
        </div>

        <div class="@GetGroupClass("dashboard")">
            <a href="javascript:;" class="menu-link">
                <div class="menu-icon"><i class="fa fa-house"></i></div>
                <div class="menu-text">Dashboard</div>
                <div class="menu-caret"></div>
            </a>
            <div class="menu-submenu">
                <div class="@GetMenuItemClass("")">
                    <NavLink class="menu-link" href="" Match="NavLinkMatch.All" data-enhance-nav="false">
                        <div class="menu-text">Home</div>
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="@GetGroupClass("workflows")">
            <a href="javascript:;" class="menu-link">
                <div class="menu-icon"><i class="fa fa-diagram-project"></i></div>
                <div class="menu-text">Workflows</div>
                <div class="menu-caret"></div>
            </a>
            <div class="menu-submenu">
                <div class="@GetMenuItemClass("workflow")">
                    <NavLink class="menu-link" href="workflow" data-enhance-nav="false">
                        <div class="menu-text">Workflow Studio</div>
                    </NavLink>
                </div>
                <div class="@GetMenuItemClass("workflow-executions")">
                    <NavLink class="menu-link" href="workflow-executions" data-enhance-nav="false">
                        <div class="menu-text">Workflow Executions</div>
                    </NavLink>
                </div>
                <div class="@GetMenuItemClass("bus-watcher")">
                    <NavLink class="menu-link" href="bus-watcher" data-enhance-nav="false">
                        <div class="menu-text">Bus Watcher</div>
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="@GetGroupClass("samples")">
            <a href="javascript:;" class="menu-link">
                <div class="menu-icon"><i class="fa fa-flask"></i></div>
                <div class="menu-text">Samples</div>
                <div class="menu-caret"></div>
            </a>
            <div class="menu-submenu">
                <div class="@GetMenuItemClass("counter")">
                    <NavLink class="menu-link" href="counter" data-enhance-nav="false">
                        <div class="menu-text">Counter</div>
                    </NavLink>
                </div>
                <div class="@GetMenuItemClass("weather")">
                    <NavLink class="menu-link" href="weather" data-enhance-nav="false">
                        <div class="menu-text">Weather</div>
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="menu-item menu-control menu-control-start">
            <a href="javascript:;" class="menu-link" data-toggle="app-top-menu-prev">
                <i class="fa fa-angle-left"></i>
            </a>
        </div>

        <div class="menu-item menu-control menu-control-end">
            <a href="javascript:;" class="menu-link" data-toggle="app-top-menu-next">
                <i class="fa fa-angle-right"></i>
            </a>
        </div>
    </div>
</div>

@code {
    private string CurrentPath
    {
        get
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            return relativePath.Split('?', '#')[0].Trim('/');
        }
    }

    private string GetMenuItemClass(string href)
    {
        var normalizedHref = href.Trim('/');
        var isActive = string.Equals(CurrentPath, normalizedHref, StringComparison.OrdinalIgnoreCase);
        return isActive ? "menu-item active" : "menu-item";
    }

    private string GetGroupClass(string group)
    {
        var isActive = group switch
        {
            "dashboard" => string.IsNullOrEmpty(CurrentPath),
            "workflows" => string.Equals(CurrentPath, "workflow", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(CurrentPath, "workflow-executions", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(CurrentPath, "bus-watcher", StringComparison.OrdinalIgnoreCase),
            "samples" => string.Equals(CurrentPath, "counter", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(CurrentPath, "weather", StringComparison.OrdinalIgnoreCase),
            _ => false
        };

        return isActive ? "menu-item has-sub active expand" : "menu-item has-sub";
    }
}
