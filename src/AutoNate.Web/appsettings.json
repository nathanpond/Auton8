{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "AutoNate.Web.Services.Events.DaprAuditEventPublisher": "Warning",
      "AutoNate.Web.Services.BusWatcher": "Warning",
      "AutoNate.Web.Services.Signals.DaprStreamingSubscriber": "Warning"
    }
  },
  "AllowedHosts": "",
  // Behind a TLS-terminating proxy / load balancer, set Enabled=true and
  // name the upstream(s). Without this, Request.IsHttps reflects the
  // proxy→app hop (http) and the auth + antiforgery cookies (SecurePolicy
  // = Always in non-Dev) silently refuse to emit — sign-in appears broken
  // with no error. See Configuration/TrustedProxyOptions.cs.
  "TrustedProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  // Grants are enforced unless a deployment deliberately says otherwise.
  // AutoNate.Web REFUSES TO START outside Development unless Enabled is true
  // and Enforcement is "full" (Authorization/AuthorizationOptionsValidator.cs);
  // an unrecognised Enforcement value is rejected in every environment,
  // because the evaluator would read it as "not full" and allow every write.
  //   Enforcement: "off" ignores grants | "read-only" filters reads but allows
  //   writes | "full" enforces both.
  //   DryRun: with Enforcement "full", log would-be write denials but allow
  //   them — a staged-rollout window, not a resting state.
  //   AssignSuperAdminToAllExistingUsers: one-shot backfill granting SuperAdmin
  //   to the users present the first time it runs. Leave true for a greenfield
  //   install (nothing else grants the first admin), then set false.
  "Authorization": {
    "Enabled": true,
    "Enforcement": "full",
    "AssignSuperAdminToAllExistingUsers": true,
    "DryRun": false
  },
  "Plugins": {
    "MaxUploadBytes": 52428800,
    "FailFastOnStartup": false
  },
  "ContentVersioning": {
    "SessionGapMinutes": 30
  },
  "Projections": {
    "MaxBatchSize": 250,
    "MaxBatchWindow": "00:00:00.500",
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00",
    "MaxAttempts": 20
  },
  "FlowableCache": {
    "ExecutionPollInterval": "00:01:00",
    "TaskPollInterval": "00:01:00",
    "VariablePollInterval": "00:05:00",
    "HistoryPollInterval": "00:01:00",
    "TaskPageSize": 200,
    "HistoryPageSize": 500,
    "VariableInstancesPerTick": 100,
    "ReadThroughFreshness": "00:00:30",
    "CurrentProjectionVersion": 1,
    "RetentionEnabled": true,
    "DefaultRetentionDays": 2555,
    "RetentionSweepInterval": "06:00:00",
    "ColdTier": {
      "Enabled": false,
      "ArchiveSweepInterval": "1.00:00:00",
      "ArchiveAfterDays": 90,
      "Root": "var/projections",
      "MaxRowsPerArchivePass": 500000,
      "MinimumRowAge": "1.00:00:00"
    }
  },
  "RecordActivityRollup": {
    "PollInterval": "01:00:00",
    "RecentDayWindow": 7,
    "CurrentProjectionVersion": 1
  }
}
