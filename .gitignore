# macOS Finder metadata
.DS_Store

# Python bytecode (some tooling here lives in Python projects)
__pycache__/
*.pyc
*.pyo


# React SPA build output (produced by MSBuild BuildReactSpa target).
# The SPA is now mounted at the site root, so Vite emits directly into wwwroot/.
# favicon.png and any other hand-maintained files in wwwroot/ stay tracked.
src/AutoNate.Spa/dist/
src/AutoNate.Web/wwwroot/assets/
src/AutoNate.Web/wwwroot/vendor/
src/AutoNate.Web/wwwroot/index.html
