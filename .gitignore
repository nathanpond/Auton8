bin/
obj/
target/
tmpflowable/
src/AutoNate.Web/App_Data/*
src/AutoNate.Web/ColorAdmin/
/packages/
node_modules/
riderModule.iml
/_ReSharper.Caches/
.env
infra/mounts/**
!infra/mounts/
!infra/mounts/*/

# macOS Finder metadata
.DS_Store

# Python bytecode (some tooling here lives in Python projects)
__pycache__/
*.pyc
*.pyo


# React SPA build output (produced by MSBuild BuildReactSpa target).
# The SPA is mounted at the site root and Vite emits directly into wwwroot/,
# so nothing in wwwroot/ is hand-maintained. Source assets like favicon.png
# live in src/AutoNate.Spa/public/ and Vite copies them into wwwroot/ at build.
src/AutoNate.Spa/dist/
src/AutoNate.Web/wwwroot/
.idea/
Test Results/

# TypeScript incremental build cache. Regenerated on every tsc/Vite build;
# tracking it produces phantom diffs and silently masks real errors when a
# stale cache hides a since-broken consumer (Vite catches it at runtime, but
# tsc with cache says "fine").
*.tsbuildinfo

# Per-user Rider settings (the shared `.DotSettings` file without the .user
# suffix is fine to commit; the .user variant is per-machine state).
*.DotSettings.user

# Playwright MCP tool output (console logs and page snapshots from
# browser-driving sessions). Pure debug scratch — same category as /temp/.
.playwright-mcp/

# Scratch directory for ad-hoc dev artifacts (debug screenshots, captured
# logs, throwaway exports). Anything worth keeping belongs in docs/ or
# alongside the code it documents — /temp is for things you don't want
# in git history.
/temp/

# Runtime data root: user uploads, persisted plugins, public /files assets,
# repositories. Container deployments mount this as a volume; locally it's
# auto-created on startup. Never commit anything that lands here.
/data/
src/AutoNate.Web/data/

