    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
