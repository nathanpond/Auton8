# Keep the build context small and deterministic. Without this, `docker build`
# uploads node_modules (hundreds of MB), every bin/ and obj/, and the
# bind-mounted Postgres data under infra/mounts — which is both slow and a way
# for local state to end up inside an image.
**/node_modules
**/bin
**/obj
**/dist
**/.vite
infra/mounts
temp
.git
.github
.idea
.vs
docs
plugins/*/dist
tests
**/*.user
**/.DS_Store
