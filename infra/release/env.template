# Auton8 __VERSION__ — configuration
#
# Put this file next to compose.yml as `.env`. Nothing here has a working
# default: every value below is either required or a deliberate choice.

# ── Required: the first administrator ───────────────────────────────────────
# Nothing is seeded. There is no registration page and no setup wizard, so
# without these there is no way to sign in. They are used once, against an
# empty database, and can be cleared afterwards.
Bootstrap__AdminUsername=
Bootstrap__AdminPassword=

# ── Required: secrets ───────────────────────────────────────────────────────
# Generate each of these yourself. Nothing generates them for you: software
# that mints its own credentials is how a placeholder becomes a live secret.
#
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)
#   WORKFLOW_CALLBACK_SECRET=$(openssl rand -hex 32)
#   YJS_SHARED_SECRET=$(openssl rand -hex 32)
POSTGRES_PASSWORD=
WORKFLOW_CALLBACK_SECRET=
YJS_SHARED_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
POSTGRES_USER=autonate
APP_PORT=5108
HOCUSPOCUS_PORT=1234
POSTGRES_PORT=5432
TZ=UTC

# Development keeps a permissive AllowedHosts and relaxed startup checks, and
# is the right setting for trying Auton8 on a laptop. For anything reachable
# by anyone else, set APP_ENVIRONMENT=Production and ALLOWED_HOSTS to the
# hostnames you actually serve — the app refuses to start otherwise, which is
# deliberate. See the deployment notes linked from QUICKSTART.md.
APP_ENVIRONMENT=Development
ALLOWED_HOSTS=*
